          Color: [0.9, 0.9, 0.9]
          Scale: 0.9
  - Name: bridge
    MapCharacter: "="
    Z: 0
    Observers:
      Sprite2D: &bridge_sprite
        - Image: gvgai/newset/logm.png
      FollowCam: *bridge_sprite
      CloseUp: *bridge_sprite
      Block2D:
        - Shape: square
          Color: [0.55, 0.4, 0.25]
          Scale: 0.9
