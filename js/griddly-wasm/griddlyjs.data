      CloseUp: *slime_blue_sprite
      Isometric: &slime_blue_iso
        - Image: remastered/slimefarm-blue-iso-0.png
        - Image: remastered/slimefarm-blue-iso-1.png
        - Image: remastered/slimefarm-blue-iso-2.png
      IsoFollow: *slime_blue_iso
      Block2D:
        - Shape: circle
          Color: [0.2, 0.5, 0.9]
          Scale: 0.45
        - Shape: circle
          Color: [0.2, 0.5, 0.9]
          Scale: 0.65
        - Shape: circle
          Color: [0.2, 0.5, 0.9]
          Scale: 0.9
  - Name: slime_pink
    MapCharacter: "p"
    Z: 1
    Variables:
      - Name: tier
        InitialValue: 0
    InitialActions:
      - Action: wander
        Delay: 8
        Randomize: true
      - Action: produce
        Delay: 30
        Randomize: true
    Observers:
      Sprite2D: &slime_pink_sprite
        - Image: remastered/slimefarm-pink-0.png
        - Image: remastered/slimefarm-pink-1.png
        - Image: remastered/slimefarm-pink-2.png
      FollowCam: *slime_pink_sprite
      CloseUp: *slime_pink_sprite
      Isometric: &slime_pink_iso
        - Image: remastered/slimefarm-pink-iso-0.png
        - Image: remastered/slimefarm-pink-iso-1.png
        - Image: remastered/slimefarm-pink-iso-2.png
      IsoFollow: *slime_pink_iso
      Block2D:
        - Shape: circle
          Color: [0.9, 0.4, 0.7]
          Scale: 0.45
        - Shape: circle
          Color: [0.9, 0.4, 0.7]
          Scale: 0.65
        - Shape: circle
          Color: [0.9, 0.4, 0.7]
          Scale: 0.9
  - Name: rancher
    MapCharacter: "A"
    Z: 1
    Variables:
      - Name: food
        InitialValue: 0
      - Name: gems
        InitialValue: 0
    InitialActions:
      - Action: face
        ActionId: 2
    Observers:
      Sprite2D: &rancher_sprite
        - Image: remastered/slimefarm-rancher-up.png
        - Image: remastered/slimefarm-rancher-right.png
        - Image: remastered/slimefarm-rancher-down.png
        - Image: remastered/slimefarm-rancher-left.png
      FollowCam: *rancher_sprite
      CloseUp: *rancher_sprite
      Isometric: &rancher_iso
        - Image: remastered/slimefarm-rancher-iso-flip.png
        - Image: remastered/slimefarm-rancher-iso.png
        - Image: remastered/slimefarm-rancher-iso.png
        - Image: remastered/slimefarm-rancher-iso-flip.png
      IsoFollow: *rancher_iso
      Block2D:
        - Shape: triangle
          Color: [0.9, 0.9, 0.2]
          Scale: 0.8
        - Shape: triangle
          Color: [0.9, 0.9, 0.2]
          Scale: 0.8
        - Shape: triangle
          Color: [0.9, 0.9, 0.2]
          Scale: 0.8
        - Shape: triangle
          Color: [0.9, 0.9, 0.2]
          Scale: 0.8
Version: "0.1"
Environment:
  Name: Sokoban Remastered
  Description: |
    Push every crate into a hole: the crate fills it and both vanish. Warehouses, walled gardens,
    a frozen lake, a crypt and a deep quarry - walls, water, hedges, trees, rocks and tombstones block
    crates; grass, sand, moss and dirt don't. Win when no crates are left.
    Generated by studio/griddly-demo/tools/remaster â€” edit the generator, not this file.
  # Cameras are observers. The demo picks one by name and the engine renders it.
  #   Sprite2D   whole level (global observer)
  #   FollowCam  15x11 window that follows the avatar
  #   CloseUp    9x9 window that follows the avatar (also the agent's default view)
  Observers:
    Sprite2D:
      TileSize: 24
      BackgroundTile: gvgai/newset/floor2.png
      RotateAvatarImage: false
      TrackAvatar: false
    FollowCam:
      Type: SPRITE_2D
      TileSize: 24
      BackgroundTile: gvgai/newset/floor2.png
      RotateAvatarImage: false
      RotateWithAvatar: false
      TrackAvatar: true
      Width: 15
      Height: 11
    CloseUp:
      Type: SPRITE_2D
      TileSize: 24
      BackgroundTile: gvgai/newset/floor2.png
      RotateAvatarImage: false
      RotateWithAvatar: false
      TrackAvatar: true
      Width: 9
      Height: 9
    Block2D:
      TileSize: 24
  Player:
    Observer:
      TrackAvatar: true
      RotateWithAvatar: false
      RotateAvatarImage: false
      Width: 9
      Height: 9
    AvatarObject: avatar
  Termination:
    Win:
      - eq: [box:count, 0]
  Levels:
    # Loading Dock | Four crates, four holes in the warehouse floor.
    - |
      w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w
      w   .   .   .   .   .   .   .   .   .   .   |   .   h   .   w   w   .   .   .   |   .   .   w
      w   .   @   .   .   .   w   w   w   w   .   .   .   .   .   w   w   .   b   .   +   _   .   w
      w   .   .   .   .   .   w   w   w   w   .   .   .   .   .   w   w   :   :   :   :   _   _   w
      w   .   .   |   .   .   w   w   w   w   .   b   |   .   .   w   w   .   .   :   :   :   @   w
      w   w   w   w   w   w   w   w   w   w   w   .   w   w   w   w   w   w   w   w   .   w   w   w
      w   w   w   w   w   w   w   w   w   w   w   .   w   w   w   w   w   w   w   w   .   w   w   w
      w   w   w   w   w   w   w   w   w   w   w   :   w   w   w   w   w   w   w   w   .   w   w   w
      w   +   .   .   _   _/h _   w   w   :   :/A :/h .   .   .   w   w   :   :   .   .   .   .   w
      w   .   b   .   _   _   _   .   .   :/b :   :   .   .   .   .   :   :   .   .   .   .   .   w
