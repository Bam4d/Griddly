        - Image: remastered/zelda-avatar-right.png
        - Image: remastered/zelda-avatar-down.png
        - Image: remastered/zelda-avatar-left.png
      FollowCam: *avatar_sprite
      CloseUp: *avatar_sprite
      Block2D:
