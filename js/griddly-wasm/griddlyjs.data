          Color: [0.7, 0.55, 0.3]
          Scale: 0.9
  - Name: bones
    MapCharacter: "+"
    Z: 0
    Observers:
      Sprite2D: &bones_sprite
        - Image: oryx/oryx_tiny_galaxy/tg_sliced/tg_world/tg_world_bones_a.png
      EgoView: *bones_sprite
      EgoClose: *bones_sprite
      FollowCam: *bones_sprite
      Block2D:
        - Shape: square
          Color: [0.8, 0.8, 0.75]
          Scale: 0.9
  - Name: mushroom
    MapCharacter: "*"
    Z: 0
    Observers:
      Sprite2D: &mushroom_sprite
        - Image: gvgai/oryx/mushroom2.png
      EgoView: *mushroom_sprite
      EgoClose: *mushroom_sprite
      FollowCam: *mushroom_sprite
      Block2D:
        - Shape: square
          Color: [0.8, 0.2, 0.2]
          Scale: 0.9
  - Name: skull
    MapCharacter: "^"
    Z: 0
    Observers:
      Sprite2D: &skull_sprite
        - Image: gvgai/oryx/skull1.png
      EgoView: *skull_sprite
      EgoClose: *skull_sprite
      FollowCam: *skull_sprite
      Block2D:
        - Shape: square
          Color: [0.9, 0.9, 0.9]
          Scale: 0.9
  - Name: bridge
