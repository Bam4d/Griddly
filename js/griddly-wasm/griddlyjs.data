Actions:
  - Name: face
    InputMapping:
      Internal: true
      Inputs:
        2: {Description: Face down, VectorToDest: [0, 0], MetaData: {facing: 2}}
    Behaviours:
      - Src: {Object: avatar, Commands: [{set_tile: meta.facing}]}
        Dst: {Object: avatar}

  # Player move (absolute). Walking onto ice starts a slide; walking into an ice block or brazier pushes
  # it (it may slide too); the avatar then steps into its old cell and keeps sliding if that cell is ice.
  - Name: move
    InputMapping:
      Inputs:
        1: {Description: Left, VectorToDest: [-1, 0], MetaData: {facing: 3}}
        2: {Description: Up, VectorToDest: [0, -1], MetaData: {facing: 0}}
        3: {Description: Right, VectorToDest: [1, 0], MetaData: {facing: 1}}
        4: {Description: Down, VectorToDest: [0, 1], MetaData: {facing: 2}}
    Behaviours:
      - Src: {Object: avatar, Commands: [{set_tile: meta.facing}, {mov: _dest}]}
        Dst: {Object: [_empty, grass, moss, dirt, sand, bones, skull]}
      - Src: {Object: avatar, Commands: [{set_tile: meta.facing}, {mov: _dest}, {exec: {Action: slide}}]}
        Dst: {Object: ice}
      - Src: {Object: avatar, Commands: [{set_tile: meta.facing}, {mov: _dest}, {reward: 5}]}
        Dst: {Object: shrine, Commands: [{remove: true}]}
      - Src: {Object: avatar, Commands: [{set_tile: meta.facing}]}
        Dst: {Object: [wall, snowman, frostwall, socket, beacon, pond, tree, bush, rock, stone, tombstone]}
      - Src:
          Object: avatar
          Commands:
            - set_tile: meta.facing
            - mov: _dest
            - if:
                Conditions: {eq: [pend, 1]}
                OnTrue:
                  - exec: {Action: slide}
        Dst: {Object: cube, Commands: [{set: [src.pend, slip]}, {cascade: _dest}]}
      - Src: {Object: avatar, Commands: [{set_tile: meta.facing}, {mov: _dest}]}
        Dst: {Object: brazier, Commands: [{cascade: _dest}]}
      - Src: {Object: cube, Commands: [{mov: _dest}, {set: [slip, 0]}]}
        Dst: {Object: [_empty, grass, moss, dirt, sand, bones, skull]}
      - Src: {Object: cube, Commands: [{mov: _dest}, {set: [slip, 1]}, {exec: {Action: slide}}]}
        Dst: {Object: ice}
      - Src: {Object: cube, Commands: [{remove: true}, {reward: 1}]}
        Dst: {Object: pond, Commands: [{change_to: ice}]}
      - Src: {Object: brazier, Commands: [{mov: _dest}]}
        Dst: {Object: [_empty, grass, moss, dirt, sand, bones, skull]}
      - Src: {Object: brazier, Commands: [{remove: true}]}
        Dst: {Object: ice, Commands: [{change_to: pond}]}
      - Src: {Object: brazier, Commands: [{remove: true}]}
        Dst: {Object: pond}
      - Src: {Object: brazier, Commands: [{remove: true}, {reward: 3}]}
        Dst: {Object: socket, Commands: [{change_to: beacon}]}
  # Internal: keep going in the same direction (exec without ActionId reuses the move's vector).
  - Name: slide
    InputMapping:
      Internal: true
    Behaviours:
      - Src: {Object: avatar, Commands: [{mov: _dest}]}
        Dst: {Object: [_empty, grass, moss, dirt, sand, bones, skull]}
      - Src: {Object: avatar, Commands: [{mov: _dest}, {exec: {Action: slide}}]}
        Dst: {Object: ice}
      - Src: {Object: avatar, Commands: [{mov: _dest}, {reward: 5}]}
        Dst: {Object: shrine, Commands: [{remove: true}]}
      - Src: {Object: cube, Commands: [{mov: _dest}, {set: [slip, 0]}]}
        Dst: {Object: [_empty, grass, moss, dirt, sand, bones, skull]}
      - Src: {Object: cube, Commands: [{mov: _dest}, {set: [slip, 1]}, {exec: {Action: slide}}]}
        Dst: {Object: ice}
      - Src: {Object: cube, Commands: [{remove: true}, {reward: 1}]}
        Dst: {Object: pond, Commands: [{change_to: ice}]}
      - Src: {Object: brazier, Commands: [{mov: _dest}]}
        Dst: {Object: [_empty, grass, moss, dirt, sand, bones, skull]}
      - Src: {Object: brazier, Commands: [{remove: true}]}
        Dst: {Object: ice, Commands: [{change_to: pond}]}
      - Src: {Object: brazier, Commands: [{remove: true}]}
        Dst: {Object: pond}
      - Src: {Object: brazier, Commands: [{remove: true}, {reward: 3}]}
        Dst: {Object: socket, Commands: [{change_to: beacon}]}
  # Fire radiates heat to the 8 surrounding cells at the end of every move.
  - Name: heat
    Trigger:
      Type: RANGE_BOX_BOUNDARY
      Range: 1
    Behaviours:
      - Src: {Object: [brazier, beacon]}
        Dst: {Object: [snowman, frostwall, cube], Commands: [{remove: true}]}

Objects:
  - Name: grass
    MapCharacter: ","
    Z: 0
    Observers:
      Sprite2D: &grass_sprite
        - TilingMode: WALL_16
          Image:
            - gvgai/oryx/grass_0.png
            - gvgai/oryx/grass_1.png
            - gvgai/oryx/grass_2.png
            - gvgai/oryx/grass_3.png
            - gvgai/oryx/grass_4.png
            - gvgai/oryx/grass_5.png
            - gvgai/oryx/grass_6.png
            - gvgai/oryx/grass_7.png
            - gvgai/oryx/grass_8.png
            - gvgai/oryx/grass_9.png
            - gvgai/oryx/grass_10.png
            - gvgai/oryx/grass_11.png
            - gvgai/oryx/grass_12.png
            - gvgai/oryx/grass_13.png
            - gvgai/oryx/grass_14.png
            - gvgai/oryx/grass_15.png
      FollowCam: *grass_sprite
      CloseUp: *grass_sprite
      Block2D:
        - Shape: square
          Color: [0.25, 0.55, 0.25]
          Scale: 0.9
  - Name: moss
    MapCharacter: ";"
    Z: 0
    Observers:
      Sprite2D: &moss_sprite
        - Image: oryx/oryx_tiny_galaxy/tg_sliced/tg_world/tg_world_floor_moss_a.png
      FollowCam: *moss_sprite
      CloseUp: *moss_sprite
      Block2D:
        - Shape: square
          Color: [0.25, 0.4, 0.2]
          Scale: 0.9
  - Name: dirt
    MapCharacter: ":"
    Z: 0
    Observers:
      Sprite2D: &dirt_sprite
        - Image: oryx/oryx_tiny_galaxy/tg_sliced/tg_world/tg_world_floor_dirt_a.png
      FollowCam: *dirt_sprite
      CloseUp: *dirt_sprite
      Block2D:
        - Shape: square
          Color: [0.3, 0.22, 0.15]
          Scale: 0.9
  - Name: sand
    MapCharacter: "_"
    Z: 0
    Observers:
      Sprite2D: &sand_sprite
        - Image: oryx/oryx_tiny_galaxy/tg_sliced/tg_world/tg_world_floor_sand_a.png
      FollowCam: *sand_sprite
      CloseUp: *sand_sprite
      Block2D:
        - Shape: square
          Color: [0.7, 0.55, 0.3]
          Scale: 0.9
  - Name: bones
    MapCharacter: "+"
    Z: 0
