      w     w     w     w     w     w     +     .     .     .     .     .     .     .     .     ;     .     _/c   _/v   _     w     w     w     w     ~     ~     *     .     ;     ;     ;     w     w
      w     w     w     w     w     w     w     w     .     .     .     ~     ~     ~     ;     ;     ;     _     _     w     w     w     w     w     w     w     ;     .     .     ;     .     w     w
      w     w     w     w     w     w     w     .     .     +     .     ~     ~     ~     .     ;     .     .     .     w     w     w     w     w     w     w     ;     ;     .     .     .     w     w
      w     w     w     w     .     .     .     .     .     b     .     ~     ~     ~     .     .     .     v     +     .     .     t     w     w     w     .     ;     .     .     .     .     w     w
      w     w     w     .     .     .     .     .     .     .     .     .     c     .     .     *     .     c     .     .     .     .     w     .     .     .     .     .     c     .     .     t     w
      w     w     w     .     .     .     .     .     .     .     .     .     .     w     .     .     ;     ;     ;     .     .     .     .     .     .     .     .     .     .     w     w     w     w
      w     w     w     .     .     c     .     .     .     .     .     .     w     w     w     w     ;     ;     ;     ;     .     .     .     .     b     .     x     .     w     w     w     w     w
      w     w     .     .     .     .     .     .     .     .     .     w     w     w     w     w     w     w     ;     ;     ~     .     .     .     .     .     .     w     w     w     w     w     w
      w     w     *     .     .     .     .     c     .     w     w     w     w     w     w     w     t     ;     ;     ~     ~     ~     .     .     .     .     w     w     w     w     w     w     w
      w     w     .     .     .     .     .     .     .     t     w     w     w     w     w     w     w     w     ;     ;     ~     .     .     .     .     w     w     w     w     w     w     w     w
      w     w     t     .     .     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     .     .     w     w     t     w     w     w     w     w     w     w     w
      w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w
    # Heart of the Mountain | Every crystal in the heart of the mountain, and everything that guards them.
    - |
      w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w
      w     w     w     w     t     w     w     w     w     .     *     .     .     .     .     w     w     w     t     w     .     .     .     .     .     .     x     .     .     t     w     w
      w     w     w     .     .     w     w     w     .     .     .     .     .     .     :     :     .     .     :     :/c   .     .     .     .     .     .     .     .     .     w     w     w
      w     w     .     c     .     .     .     .     .     v     .     .     .     .     .     :     :     :     .     :     :     :     ^     :     .     .     .     .     x     .     w     w
      w     w     .     .     .     .     ;     .     .     .     .     .     .     :/v   :     :     :     :     :     :     .     +     :     :     :     :     .     .     .     .     .     w
      w     w     w     .     .     ;     ^     ;     ;     .     b     t     w     w     w     w     :     ^     .     :     .     .     .     :     :     :     :     .     .     .     .     w
      w     w     w     .     .     +     ;     ;     ;     .     .     w     w     w     w     w     w     w     w     w     w     w     w     +     :/v   :     :     .     v     .     w     w
      w     w     w     w     w     .     ;     ;     ;     ;     w     w     w     w     w     w     w     w     w     w     w     w     w     .     :     :     :     .     :     :     w     w
      w     w     w     w     w     w     ;     ;     .     .     .     .     .     .     .     .     .     .     .     *     .     .     .     :     :     :     .     .     :     :     w     w
      w     w     w     w     w     w     w     .     .     .     .     .     .     .     .     .     .     .     ;     .     .     .     .     +     ^     .     w     .     .     :     w     w
      w     w     w     w     w     w     w     w     .     .     *     .     .     .     .     .     ;/A[U] ;     ;     .     .     .     .     #     #     .     w     .     .     .     w     w
      w     w     w     w     w     w     t     .     ^     .     .     .     :     :     .     .     ;     ;     .     .     .     .     .     .     .     .     .     .     .     c     t     w
      w     w     w     w     w     w     .     .     .     .     .     .     :     :     :     .     .     .     w     w     w     w     c     +     .     .     c     .     .     +     w     w
      w     w     w     w     w     w     .     .     .     .     .     w     w     w     w     w     w     w     w     w     w     w     .     .     .     .     ;     ;     ;     .     w     w
      w     w     w     .     .     .     .     .     .     .     w     w     w     w     w     w     w     w     w     w     w     w     w     .     .     .     ;     .     ;     .     w     w
      w     w     .     b     .     .     .     .     .     c     w     t     w     w     w     w     w     w     w     w     w     t     w     w     *     .     ;     ;     ;     ;     w     w
      w     .     .     .     v     .     .     .     w     .     .     .     .     .     ;     ;     w     w     w     w     .     .     .     x     .     .     ;     ;     ;     ;     ;     w
      w     w     .     .     .     +     .     :     .     .     .     c     .     ;     ;     ;     w     .     .     .     .     .     .     .     #     .     .     #     #     ;     .     w
      w     t     .     w     +     .     :     :     .     .     .     .     .     #     ;     .     .     ;     .     .     .     .     .     .     .     .     ^     +     .     .     w     w
      w     w     w     w     .     .     :     :     .     .     .     .     .     .     c     .     .     .     .     .     .     .     .     +     w     w     w     t     w     w     w     w
      w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w     w

Actions:
  # Publishes the avatar's position and facing in globals ax/ay/adx/ady (read by the NPC logic).
  - Name: sync
    InputMapping:
      Internal: true
      Inputs:
        1: {Description: Sync, VectorToDest: [0, 0]}
    Behaviours:
      - Src: {Object: avatar, Commands: [{set: [ax, _x]}, {set: [ay, _y]}, {set: [adx, _dx]}, {set: [ady, _dy]}]}
        Dst: {Object: avatar}

  # Stand still for one tick.
  - Name: wait
    InputMapping:
      Inputs:
        1: {Description: Wait, VectorToDest: [0, 0]}
    Behaviours:
      - Src: {Object: avatar, Commands: [{nop: []}]}
        Dst: {Object: avatar}

  # The torch burns 1 fuel every tick (self-scheduled).
  - Name: burn
    InputMapping:
      Internal: true
      Inputs:
        1: {Description: Burn, VectorToDest: [0, 0]}
    Behaviours:
      - Src: {Object: avatar, Commands: [{decr: fuel}, {exec: {Action: burn, ActionId: 1, Delay: 1}}]}
        Dst: {Object: avatar}

  # Relative movement: 1 turn left, 2 forward, 3 turn right, 4 back up (facing kept).
  - Name: move
    InputMapping:
      Relative: true
      Inputs:
        1: {Description: Turn left, OrientationVector: [-1, 0], MetaData: {fwd: 0}}
        2: {Description: Forward, OrientationVector: [0, -1], VectorToDest: [0, -1], MetaData: {fwd: 1}}
        3: {Description: Turn right, OrientationVector: [1, 0], MetaData: {fwd: 0}}
        4: {Description: Back up, OrientationVector: [0, -1], VectorToDest: [0, 1], MetaData: {fwd: 0}}
    Behaviours:
      - Src: {Object: avatar, Commands: [{rot: _dir}, {exec: {Action: sync, ActionId: 1}}]}
        Dst: {Object: avatar}
      - Src: {Object: avatar, Commands: [{mov: _dest}, {exec: {Action: sync, ActionId: 1}}]}
        Dst: {Object: [_empty, grass, moss, dirt, sand, bones, mushroom, skull, bridge]}
      - Src: {Object: avatar, Commands: [{mov: _dest}, {reward: 1}, {exec: {Action: sync, ActionId: 1}}]}
        Dst: {Object: crystal, Commands: [{remove: true}]}
      - Src:
          Object: avatar
          Preconditions: [{eq: [meta.fwd, 1]}]
          Commands: [{set: [fuel, 80]}, {reward: 1}]
        Dst: {Object: sconce, Commands: [{change_to: sconce_lit}]}
      - Src:
          Object: avatar
          Preconditions: [{eq: [meta.fwd, 1]}]
          Commands: [{set: [fuel, 80]}, {reward: 1}]
        Dst: {Object: brazier, Commands: [{change_to: brazier_lit}]}
      - Src:
          Object: avatar
          Preconditions: [{eq: [meta.fwd, 1]}]
          Commands: [{set: [fuel, 80]}]
        Dst: {Object: [sconce_lit, brazier_lit]}
      - Src: {Object: avatar, Preconditions: [{eq: [meta.fwd, 1]}], Commands: [{nop: []}]}
        Dst: {Object: spider, Commands: [{cascade: _dest}]}
      - Src: {Object: avatar, Preconditions: [{eq: [meta.fwd, 0]}], Commands: [{remove: true}]}
        Dst: {Object: spider}
      # (cascaded) a spider driven back by the torch, stunned for 2 of its turns
      - Src: {Object: spider, Commands: [{mov: _dest}, {set: [stun, 2]}, {set_tile: 1}]}
        Dst: {Object: [_empty, grass, moss, dirt, sand, bones, mushroom, skull, bridge]}
      - Src: {Object: spider, Commands: [{set: [stun, 2]}, {set_tile: 1}]}
        Dst: {Object: [wall, sconce, sconce_lit, brazier, brazier_lit, water, rock, stone, bat, spider, crystal]}
      - Src: {Object: avatar, Commands: [{sub: [fuel, 3]}]}
        Dst: {Object: bat, Commands: [{remove: true}]}

  # Light freezes spiders: lit sconces light a 5x5 area, lit braziers a 7x7 area.
  - Name: light
    Trigger: {Type: RANGE_BOX_AREA, Range: 2}
    Behaviours:
      - Src: {Object: sconce_lit}
        Dst: {Object: spider, Commands: [{set: [lit, 1]}]}
  - Name: bright_light
    Trigger: {Type: RANGE_BOX_AREA, Range: 3}
    Behaviours:
      - Src: {Object: brazier_lit}
        Dst: {Object: spider, Commands: [{set: [lit, 1]}]}

  # Spider (weeping angel): every 3 ticks, if awake (within 6) and not looked at / not lit, creep 1 step
  # towards the player along the longer axis, else the shorter one.
  - Name: stalk
    InputMapping:
      Internal: true
      Inputs:
        1: {Description: Think, VectorToDest: [0, 0]}
    Behaviours:
      - Src:
          Object: spider
          Commands:
            - exec: {Action: stalk, ActionId: 1, Delay: 3}
            - set: [rx, _x]
            - sub: [rx, ax]
            - set: [ry, _y]
            - sub: [ry, ay]
            - set: [arx, rx]
            - if: {Conditions: {lt: [rx, 0]}, OnTrue: [{set: [arx, 0]}, {sub: [arx, rx]}]}
            - set: [ary, ry]
            - if: {Conditions: {lt: [ry, 0]}, OnTrue: [{set: [ary, 0]}, {sub: [ary, ry]}]}
            - if: {Conditions: {eq: [adx, 1]}, OnTrue: [{set: [f, rx]}, {set: [l, ry]}]}
            - if: {Conditions: {eq: [adx, -1]}, OnTrue: [{set: [f, 0]}, {sub: [f, rx]}, {set: [l, ry]}]}
            - if: {Conditions: {eq: [ady, 1]}, OnTrue: [{set: [f, ry]}, {set: [l, rx]}]}
            - if: {Conditions: {eq: [ady, -1]}, OnTrue: [{set: [f, 0]}, {sub: [f, ry]}, {set: [l, rx]}]}
            - set: [nl, 0]
            - sub: [nl, l]
            - set: [frozen, lit]
            - if: {Conditions: {gt: [stun, 0]}, OnTrue: [{decr: stun}, {set: [frozen, 1]}]}
            - if:
                Conditions: {and: [{gte: [f, 1]}, {lte: [f, 8]}, {lte: [l, f]}, {lte: [nl, f]}]}
                OnTrue: [{set: [frozen, 1]}]
            - set: [lit, 0]
            - if: {Conditions: {eq: [frozen, 1]}, OnTrue: [{set_tile: 1}], OnFalse: [{set_tile: 0}]}
            - set: [dir, 0]
            - set: [dir2, 0]
            - if:
                Conditions: {and: [{eq: [frozen, 0]}, {lte: [arx, 6]}, {lte: [ary, 6]}]}
                OnTrue:
                  - if: {Conditions: {gt: [rx, 0]}, OnTrue: [{set: [hx, 1]}], OnFalse: [{set: [hx, 3]}]}
                  - if: {Conditions: {gt: [ry, 0]}, OnTrue: [{set: [hy, 2]}], OnFalse: [{set: [hy, 4]}]}
                  - if: {Conditions: {eq: [rx, 0]}, OnTrue: [{set: [hx, 0]}]}
                  - if: {Conditions: {eq: [ry, 0]}, OnTrue: [{set: [hy, 0]}]}
                  - if: {Conditions: {gte: [arx, ary]}, OnTrue: [{set: [dir, hx]}, {set: [dir2, hy]}], OnFalse: [{set: [dir, hy]}, {set: [dir2, hx]}]}
            - set: [blocked, 0]
            - if: {Conditions: {gt: [dir, 0]}, OnTrue: [{exec: {Action: creep, ActionId: dir}}]}
            - if: {Conditions: {and: [{eq: [blocked, 1]}, {gt: [dir2, 0]}]}, OnTrue: [{exec: {Action: creep, ActionId: dir2}}]}
        Dst: {Object: spider}
  - Name: creep
    InputMapping:
      Internal: true
      Inputs:
        1: {Description: West, VectorToDest: [-1, 0], OrientationVector: [-1, 0]}
        2: {Description: North, VectorToDest: [0, -1], OrientationVector: [0, -1]}
        3: {Description: East, VectorToDest: [1, 0], OrientationVector: [1, 0]}
        4: {Description: South, VectorToDest: [0, 1], OrientationVector: [0, 1]}
        5: {Description: Hover, VectorToDest: [0, 0]}
        6: {Description: Hover, VectorToDest: [0, 0]}
    Behaviours:
      - Src: {Object: spider, Commands: [{rot: _dir}, {mov: _dest}]}
        Dst: {Object: [_empty, grass, moss, dirt, sand, bones, mushroom, skull, bridge]}
      - Src: {Object: spider, Commands: [{rot: _dir}]}
        Dst: {Object: avatar, Commands: [{remove: true}]}
      - Src: {Object: spider, Commands: [{set: [blocked, 1]}]}
        Dst: {Object: [wall, sconce, sconce_lit, brazier, brazier_lit, water, rock, stone, bat, spider, crystal]}

  # Bat: every tick. Within 3 tiles of the torch it flies straight away (other axis if blocked); if it
  # is cornered right next to you it flaps at the flame (-1 fuel). Otherwise it flutters at random.
  - Name: flutter
    InputMapping:
      Internal: true
      Inputs:
        1: {Description: Think, VectorToDest: [0, 0]}
    Behaviours:
      - Src:
          Object: bat
          Commands:
            - exec: {Action: flutter, ActionId: 1, Delay: 1}
            - set: [rx, _x]
            - sub: [rx, ax]
            - set: [ry, _y]
            - sub: [ry, ay]
            - set: [arx, rx]
            - if: {Conditions: {lt: [rx, 0]}, OnTrue: [{set: [arx, 0]}, {sub: [arx, rx]}]}
            - set: [ary, ry]
            - if: {Conditions: {lt: [ry, 0]}, OnTrue: [{set: [ary, 0]}, {sub: [ary, ry]}]}
            - set: [blocked, 0]
            - if:
                Conditions: {and: [{lte: [arx, 3]}, {lte: [ary, 3]}]}
                OnTrue:
                  - if: {Conditions: {gte: [rx, 0]}, OnTrue: [{set: [hx, 3]}], OnFalse: [{set: [hx, 1]}]}
                  - if: {Conditions: {gte: [ry, 0]}, OnTrue: [{set: [hy, 4]}], OnFalse: [{set: [hy, 2]}]}
                  - if: {Conditions: {gte: [arx, ary]}, OnTrue: [{set: [dir, hx]}, {set: [dir2, hy]}], OnFalse: [{set: [dir, hy]}, {set: [dir2, hx]}]}
                  - exec: {Action: flap, ActionId: dir}
                  - if: {Conditions: {eq: [blocked, 1]}, OnTrue: [{set: [blocked, 0]}, {exec: {Action: flap, ActionId: dir2}}]}
                  - if:
                      Conditions: {and: [{eq: [blocked, 1]}, {lte: [arx, 1]}, {lte: [ary, 1]}]}
                      OnTrue: [{sub: [fuel, 1]}]
                OnFalse:
                  - exec: {Action: flap, Randomize: true}
        Dst: {Object: bat}
  - Name: flap
    InputMapping:
      Internal: true
      Inputs:
        1: {Description: West, VectorToDest: [-1, 0], OrientationVector: [-1, 0]}
        2: {Description: North, VectorToDest: [0, -1], OrientationVector: [0, -1]}
        3: {Description: East, VectorToDest: [1, 0], OrientationVector: [1, 0]}
        4: {Description: South, VectorToDest: [0, 1], OrientationVector: [0, 1]}
        5: {Description: Hover, VectorToDest: [0, 0]}
        6: {Description: Hover, VectorToDest: [0, 0]}
    Behaviours:
      - Src: {Object: bat, Commands: [{mov: _dest}]}
        Dst: {Object: [_empty, grass, moss, dirt, sand, bones, mushroom, skull, bridge]}
      - Src: {Object: bat, Commands: [{set: [blocked, 1]}]}
        Dst: {Object: [wall, sconce, sconce_lit, brazier, brazier_lit, water, rock, stone, bat, spider, crystal, avatar]}

Objects:
  - Name: grass
    MapCharacter: ","
    Z: 0
    Observers:
      Sprite2D: &grass_sprite
        - TilingMode: WALL_16
          Image:
            - gvgai/oryx/grass_0.png
            - gvgai/oryx/grass_1.png
            - gvgai/oryx/grass_2.png
            - gvgai/oryx/grass_3.png
            - gvgai/oryx/grass_4.png
            - gvgai/oryx/grass_5.png
            - gvgai/oryx/grass_6.png
            - gvgai/oryx/grass_7.png
            - gvgai/oryx/grass_8.png
            - gvgai/oryx/grass_9.png
            - gvgai/oryx/grass_10.png
            - gvgai/oryx/grass_11.png
            - gvgai/oryx/grass_12.png
            - gvgai/oryx/grass_13.png
            - gvgai/oryx/grass_14.png
            - gvgai/oryx/grass_15.png
      EgoView: *grass_sprite
      EgoClose: *grass_sprite
      FollowCam: *grass_sprite
      Block2D:
        - Shape: square
          Color: [0.25, 0.55, 0.25]
          Scale: 0.9
  - Name: moss
    MapCharacter: ";"
    Z: 0
    Observers:
      Sprite2D: &moss_sprite
