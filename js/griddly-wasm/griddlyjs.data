      FollowCam: *bush_sprite
      CloseUp: *bush_sprite
      Block2D:
        - Shape: square
          Color: [0.1, 0.45, 0.15]
          Scale: 1.0
  - Name: rock
    MapCharacter: "#"
    Z: 1
    Observers:
      Sprite2D: &rock_sprite
        - TilingMode: WALL_16
