␀␀…␀␀␀␀␀¯␀␀␀‘␀␀␀b␀␀␀À␀␀␀␀␀␀‰␀␀␀M␀␀ÏŸ␀␀␀•␀␀␀stco␀␀␀␀␀␀␀␀␀␀0␀Ê*␀␀␀audta␀␀␀Ymeta␀␀␀␀␀␀␀!hdlr␀␀␀␀␀␀␀␀mdirappl␀␀␀␀␀␀␀␀␀␀␀␀,ilst␀␀␀$©too␀␀␀data␀␀␀␀␀␀␀Lavf63.1.102Version: "0.1"
Environment:
  Name: GriddlyRTS-FoW
  Description: |
    Two-player RTS with per-player cameras (partial views), a global mini-map,
    four unit types, a lab and a small research tree.

    The GDY only defines the rules. All decision making - harvesting, building,
    researching, army control - is done by the player (see fow_policy.py).
    Each player's camera is the (cam_x, cam_y) global pair, moved with the arrow
    keys via move_camera; renderers crop a window around it.

    Units (trained at the base / barracks):
      worker   hp 6   dmg 1  gathers minerals, builds barracks and labs
      trooper  hp 12  dmg 3  (object name: combat) melee
      gunner   hp 8   dmg 2  (object name: marine) melee + ranged shot at distance 2; needs Gunnery
      tank     hp 30  dmg 5  melee, moves only every other tick; needs Vehicles
    Research (at the lab, one project at a time per lab; 0 = none, 1 = researching, 2 = done):
      Advanced mining  workers deposit 2 resources per trip
      Weapons          +1 damage for all of the player's units
      Armour           -1 damage taken by all of the player's units and buildings
      Gunnery          (needs Weapons) unlocks gunners
      Vehicles         (needs Armour)  unlocks tanks
  Observers:
    Block2D:
      TileSize: 8
      BackgroundColor: [ 0.1, 0.1, 0.15 ]
    Sprite2D:
      TileSize: 16
      BackgroundTile: oryx/oryx_tiny_galaxy/tg_sliced/tg_world/tg_world_floor_panel_metal_a.png
      # a soft player-coloured shadow under every owned object. Colours are egocentric:
      # in a player's own view their objects use Colors[0] (green), the enemy Colors[1].
      # HighlightStyle can also be GLOW (centred on the object) or OUTLINE.
      HighlightPlayers: true
      HighlightStyle: SHADOW
      # shadow width relative to the sprite
      HighlightScale: 1.6
    Vector:
      IncludePlayerId: true
      IncludeVariables: true
  Variables:
    - Name: player_resources
      InitialValue: 10
      PerPlayer: true
    # per-player camera position (the centre of the player's partial view)
    - Name: cam_x
      InitialValue: 0
      PerPlayer: true
    - Name: cam_y
      InitialValue: 0
      PerPlayer: true
    # research state per player: 0 = not researched, 1 = in progress, 2 = done
    - Name: res_mining
      InitialValue: 0
      PerPlayer: true
    - Name: res_weapons
      InitialValue: 0
      PerPlayer: true
    - Name: res_armor
      InitialValue: 0
      PerPlayer: true
    - Name: res_gunnery
      InitialValue: 0
      PerPlayer: true
    - Name: res_vehicles
      InitialValue: 0
      PerPlayer: true
  Player:
    Count: 2
    # egocentric player colours: each player sees itself as the first colour (green)
    # and the enemy as the second. The global observer uses player 1 / player 2 directly.
    Colors:
      - [ 0.2, 0.9, 0.3 ]
      - [ 0.95, 0.3, 0.25 ]
  Termination:
    Lose:
      - Conditions:
          - eq: [ base:count, 0 ]
        Reward: -10
        OpposingReward: 10
  Levels:
    - |
      M   M   M   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .
      M   M   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .
      M   .   .   .   .   .   .   .   .   .   .   .   W   W   .   .   .   .   .   .
      .   .   .   A1  H1  .   .   .   .   .   .   .   .   .   .   .   .   .   .   .
      .   .   .   H1  .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .
      .   .   .   .   .   .   .   .   W   W   .   .   .   .   .   .   .   .   .   .
      .   .   .   .   .   .   .   .   W   .   .   .   .   .   .   .   .   .   .   .
      .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .
      .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   W   .   .   .   .
      .   .   .   .   .   .   .   .   .   W   .   .   .   .   W   W   .   .   .   .
      .   .   .   .   W   W   .   .   .   .   W   .   .   .   .   .   .   .   .   .
      .   .   .   .   W   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .
      .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .
      .   .   .   .   .   .   .   .   .   .   .   W   .   .   .   .   .   .   .   .
      .   .   .   .   .   .   .   .   .   .   W   W   .   .   .   .   .   .   .   .
      .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   H2  .   .   .
      .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   H2  A2  .   .   .
      .   .   .   .   .   .   W   W   .   .   .   .   .   .   .   .   .   .   .   M
      .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   M   M
      .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   M   M   M

Actions:
  - Name: move_camera
    InputMapping:
      Inputs:
        1:
          Description: Pan camera left
          VectorToDest: [ 0, 0 ]
          MetaData: { dx: -1, dy: 0 }
          KeyBinding: ArrowLeft
        2:
          Description: Pan camera up
          VectorToDest: [ 0, 0 ]
          MetaData: { dx: 0, dy: -1 }
          KeyBinding: ArrowUp
        3:
          Description: Pan camera right
          VectorToDest: [ 0, 0 ]
          MetaData: { dx: 1, dy: 0 }
          KeyBinding: ArrowRight
        4:
          Description: Pan camera down
          VectorToDest: [ 0, 0 ]
          MetaData: { dx: 0, dy: 1 }
          KeyBinding: ArrowDown
    Behaviours:
      - Src:
          ObjectRules: base
          Commands:
            - add: [ cam_x, meta.dx ]
            - add: [ cam_y, meta.dy ]
            - lt:
                Arguments: [ cam_x, 0 ]
                Commands:
                  - set: [ cam_x, 0 ]
            - gt:
                Arguments: [ cam_x, 19 ]
                Commands:
                  - set: [ cam_x, 19 ]
            - lt:
                Arguments: [ cam_y, 0 ]
                Commands:
                  - set: [ cam_y, 0 ]
            - gt:
                Arguments: [ cam_y, 19 ]
                Commands:
                  - set: [ cam_y, 19 ]
        Dst:
          ObjectRules: base


  - Name: move
    InputMapping:
      Inputs:
        1: { Description: Move left, VectorToDest: [ -1, 0 ], KeyBinding: "a" }
        2: { Description: Move up, VectorToDest: [ 0, -1 ], KeyBinding: "w" }
        3: { Description: Move right, VectorToDest: [ 1, 0 ], KeyBinding: "d" }
        4: { Description: Move down, VectorToDest: [ 0, 1 ], KeyBinding: "s" }
    Behaviours:
      - Src:
          ObjectRules: [ worker, combat, marine ]
          Commands:
            - mov: _dest
        Dst:
          ObjectRules: _empty
      # tanks are slow: after moving they must wait for tank_ready before moving again
      - Src:
          ObjectRules: tank
          Preconditions:
            - eq: [ src.cooldown, 0 ]
          Commands:
            - set: [ src.cooldown, 1 ]
            - mov: _dest
            - exec:
                Action: tank_ready
                Delay: 2
                ActionId: 1
        Dst:
          ObjectRules: _empty

  # Gather from an adjacent mineral (max 1 carried), or deposit into an adjacent own base.
  - Name: gather
    InputMapping:
      Inputs:
        1: { Description: Gather/deposit left, VectorToDest: [ -1, 0 ], KeyBinding: "g+a" }
        2: { Description: Gather/deposit up, VectorToDest: [ 0, -1 ], KeyBinding: "g+w" }
        3: { Description: Gather/deposit right, VectorToDest: [ 1, 0 ], KeyBinding: "g+d" }
        4: { Description: Gather/deposit down, VectorToDest: [ 0, 1 ], KeyBinding: "g+s" }
    Behaviours:
      - Src:
          ObjectRules: worker
          Preconditions:
            - eq: [ src.carrying, 0 ]
          Commands:
            - set: [ src.carrying, 1 ]
            - reward: 1
        Dst:
          ObjectRules: minerals
          Commands:
            - decr: dst.resources
            - lt:
                Arguments: [ dst.resources, 7 ]
                Commands:
                  - set_tile: 1
            - lt:
                Arguments: [ dst.resources, 4 ]
                Commands:
                  - set_tile: 2
            - lte:
                Arguments: [ dst.resources, 0 ]
                Commands:
                  - remove: true
      - Src:
          ObjectRules: worker
          Preconditions:
            - eq: [ src.carrying, 1 ]
            - eq: [ src._playerId, dst._playerId ]
          Commands:
            - set: [ src.carrying, 0 ]
            - reward: 1
        Dst:
          ObjectRules: base
          Commands:
            - incr: player_resources
            - eq:
                Arguments: [ res_mining, 2 ]
                Commands:
                  - incr: player_resources

  # Melee attack on an adjacent enemy unit or building.
  - Name: attack
    InputMapping:
      Inputs:
        1: { Description: Attack left, VectorToDest: [ -1, 0 ], KeyBinding: "f+a" }
        2: { Description: Attack up, VectorToDest: [ 0, -1 ], KeyBinding: "f+w" }
        3: { Description: Attack right, VectorToDest: [ 1, 0 ], KeyBinding: "f+d" }
        4: { Description: Attack down, VectorToDest: [ 0, 1 ], KeyBinding: "f+s" }
    Behaviours:
      - Src:
          ObjectRules: [ worker, combat, marine, tank ]
          Preconditions:
            - neq: [ src._playerId, dst._playerId ]
          Commands:
            - reward: 1
        Dst:
          ObjectRules: [ worker, combat, marine, tank, base, barracks, lab ]
          Commands:
            # damage = attacker damage (+1 with the attacker's Weapons upgrade)
            #          (-1 with the defender's Armour upgrade)
            - sub: [ dst.health, src.damage ]
            - eq:
                Arguments: [ src.res_weapons, 2 ]
                Commands:
                  - sub: [ dst.health, 1 ]
            - eq:
                Arguments: [ res_armor, 2 ]
                Commands:
                  - add: [ dst.health, 1 ]
            - lte:
                Arguments: [ dst.health, 0 ]
                Commands:
                  - remove: true

  # Gunners shoot an enemy exactly 2 cells away in a straight line (over anything in between).
  - Name: shoot
    InputMapping:
      Inputs:
        1: { Description: Shoot 2 cells left, VectorToDest: [ -2, 0 ], KeyBinding: "x+a" }
        2: { Description: Shoot 2 cells up, VectorToDest: [ 0, -2 ], KeyBinding: "x+w" }
        3: { Description: Shoot 2 cells right, VectorToDest: [ 2, 0 ], KeyBinding: "x+d" }
        4: { Description: Shoot 2 cells down, VectorToDest: [ 0, 2 ], KeyBinding: "x+s" }
    Behaviours:
      - Src:
          ObjectRules: marine
          Preconditions:
            - neq: [ src._playerId, dst._playerId ]
          Commands:
            - reward: 1
        Dst:
          ObjectRules: [ worker, combat, marine, tank, base, barracks, lab ]
          Commands:
            # damage = attacker damage (+1 with the attacker's Weapons upgrade)
            #          (-1 with the defender's Armour upgrade)
            - sub: [ dst.health, src.damage ]
            - eq:
                Arguments: [ src.res_weapons, 2 ]
                Commands:
                  - sub: [ dst.health, 1 ]
            - eq:
                Arguments: [ res_armor, 2 ]
                Commands:
                  - add: [ dst.health, 1 ]
            - lte:
                Arguments: [ dst.health, 0 ]
                Commands:
                  - remove: true

  # Builds spawn immediately into the adjacent cell in the chosen direction.
  - Name: build_worker
    InputMapping:
      Inputs:
        1: { Description: Train worker (left of base), VectorToDest: [ -1, 0 ], KeyBinding: "1+a" }
        2: { Description: Train worker (up of base), VectorToDest: [ 0, -1 ], KeyBinding: "1+w" }
        3: { Description: Train worker (right of base), VectorToDest: [ 1, 0 ], KeyBinding: "1+d" }
        4: { Description: Train worker (down of base), VectorToDest: [ 0, 1 ], KeyBinding: "1+s" }
    Behaviours:
      - Src:
          ObjectRules: base
          Preconditions:
            - gte: [ player_resources, 5 ]
          Commands:
            - sub: [ player_resources, 5 ]
            - spawn: worker
        Dst:
          ObjectRules: _empty

  - Name: build_barracks
    InputMapping:
      Inputs:
        1: { Description: Build barracks left of worker, VectorToDest: [ -1, 0 ], KeyBinding: "b+a" }
        2: { Description: Build barracks up of worker, VectorToDest: [ 0, -1 ], KeyBinding: "b+w" }
        3: { Description: Build barracks right of worker, VectorToDest: [ 1, 0 ], KeyBinding: "b+d" }
        4: { Description: Build barracks down of worker, VectorToDest: [ 0, 1 ], KeyBinding: "b+s" }
    Behaviours:
      - Src:
          ObjectRules: worker
          Preconditions:
            - gte: [ player_resources, 15 ]
          Commands:
            - sub: [ player_resources, 15 ]
            - spawn: barracks
        Dst:
          ObjectRules: _empty

  - Name: build_lab
    InputMapping:
      Inputs:
        1: { Description: Build lab left of worker, VectorToDest: [ -1, 0 ], KeyBinding: "l+a" }
        2: { Description: Build lab up of worker, VectorToDest: [ 0, -1 ], KeyBinding: "l+w" }
        3: { Description: Build lab right of worker, VectorToDest: [ 1, 0 ], KeyBinding: "l+d" }
        4: { Description: Build lab down of worker, VectorToDest: [ 0, 1 ], KeyBinding: "l+s" }
    Behaviours:
      - Src:
          ObjectRules: worker
          Preconditions:
            - gte: [ player_resources, 10 ]
          Commands:
            - sub: [ player_resources, 10 ]
            - spawn: lab
        Dst:
          ObjectRules: _empty

  - Name: build_combat
    InputMapping:
      Inputs:
        1: { Description: Train trooper (left of barracks), VectorToDest: [ -1, 0 ], KeyBinding: "c+a" }
        2: { Description: Train trooper (up of barracks), VectorToDest: [ 0, -1 ], KeyBinding: "c+w" }
        3: { Description: Train trooper (right of barracks), VectorToDest: [ 1, 0 ], KeyBinding: "c+d" }
        4: { Description: Train trooper (down of barracks), VectorToDest: [ 0, 1 ], KeyBinding: "c+s" }
    Behaviours:
      - Src:
          ObjectRules: barracks
          Preconditions:
            - gte: [ player_resources, 5 ]
          Commands:
            - sub: [ player_resources, 5 ]
            - spawn: combat
        Dst:
          ObjectRules: _empty

  - Name: build_marine
    InputMapping:
      Inputs:
        1: { Description: Train gunner (left of barracks), VectorToDest: [ -1, 0 ], KeyBinding: "g+a" }
        2: { Description: Train gunner (up of barracks), VectorToDest: [ 0, -1 ], KeyBinding: "g+w" }
        3: { Description: Train gunner (right of barracks), VectorToDest: [ 1, 0 ], KeyBinding: "g+d" }
        4: { Description: Train gunner (down of barracks), VectorToDest: [ 0, 1 ], KeyBinding: "g+s" }
    Behaviours:
      - Src:
          ObjectRules: barracks
          Preconditions:
            - gte: [ player_resources, 6 ]
            - eq: [ res_gunnery, 2 ]
          Commands:
            - sub: [ player_resources, 6 ]
            - spawn: marine
        Dst:
          ObjectRules: _empty

  - Name: build_tank
    InputMapping:
      Inputs:
        1: { Description: Train tank (left of barracks), VectorToDest: [ -1, 0 ], KeyBinding: "t+a" }
        2: { Description: Train tank (up of barracks), VectorToDest: [ 0, -1 ], KeyBinding: "t+w" }
        3: { Description: Train tank (right of barracks), VectorToDest: [ 1, 0 ], KeyBinding: "t+d" }
        4: { Description: Train tank (down of barracks), VectorToDest: [ 0, 1 ], KeyBinding: "t+s" }
    Behaviours:
      - Src:
          ObjectRules: barracks
          Preconditions:
            - gte: [ player_resources, 12 ]
            - eq: [ res_vehicles, 2 ]
          Commands:
            - sub: [ player_resources, 12 ]
            - spawn: tank
        Dst:
          ObjectRules: _empty

  # Research is issued on a lab; the tech id is passed as action metadata.
  - Name: research
    InputMapping:
      Inputs:
        1: { Description: "Research Advanced mining (8, 8 ticks): workers deposit 2 resources per trip", VectorToDest: [ 0, 0 ], MetaData: { tech: 1 }, KeyBinding: "r+1" }
        2: { Description: "Research Weapons (10, 8 ticks): +1 damage for every unit", VectorToDest: [ 0, 0 ], MetaData: { tech: 2 }, KeyBinding: "r+2" }
        3: { Description: "Research Armour (10, 8 ticks): -1 damage taken by every unit and building", VectorToDest: [ 0, 0 ], MetaData: { tech: 3 }, KeyBinding: "r+3" }
        4: { Description: "Research Gunnery (12, 10 ticks, needs weapons): unlocks gunners (ranged) at the barracks", VectorToDest: [ 0, 0 ], MetaData: { tech: 4 }, KeyBinding: "r+4" }
        5: { Description: "Research Vehicles (12, 10 ticks, needs armor): unlocks tanks at the barracks", VectorToDest: [ 0, 0 ], MetaData: { tech: 5 }, KeyBinding: "r+5" }
    Behaviours:
      - Src:
          ObjectRules: lab
          Preconditions:
            - eq: [ meta.tech, 1 ]
            - eq: [ src.busy, 0 ]
            - eq: [ res_mining, 0 ]
            - gte: [ player_resources, 8 ]
          Commands:
            - sub: [ player_resources, 8 ]
            - set: [ res_mining, 1 ]
            - set: [ src.busy, 1 ]
            - exec:
                Action: research_done
                Delay: 8
                ActionId: 1
        Dst:
          ObjectRules: lab
      - Src:
          ObjectRules: lab
          Preconditions:
            - eq: [ meta.tech, 2 ]
            - eq: [ src.busy, 0 ]
            - eq: [ res_weapons, 0 ]
            - gte: [ player_resources, 10 ]
          Commands:
            - sub: [ player_resources, 10 ]
            - set: [ res_weapons, 1 ]
            - set: [ src.busy, 2 ]
            - exec:
                Action: research_done
                Delay: 8
                ActionId: 1
        Dst:
          ObjectRules: lab
      - Src:
          ObjectRules: lab
          Preconditions:
            - eq: [ meta.tech, 3 ]
            - eq: [ src.busy, 0 ]
            - eq: [ res_armor, 0 ]
            - gte: [ player_resources, 10 ]
          Commands:
            - sub: [ player_resources, 10 ]
            - set: [ res_armor, 1 ]
            - set: [ src.busy, 3 ]
            - exec:
                Action: research_done
                Delay: 8
                ActionId: 1
        Dst:
          ObjectRules: lab
      - Src:
          ObjectRules: lab
          Preconditions:
            - eq: [ meta.tech, 4 ]
            - eq: [ src.busy, 0 ]
            - eq: [ res_gunnery, 0 ]
            - gte: [ player_resources, 12 ]
            - eq: [ res_weapons, 2 ]
          Commands:
            - sub: [ player_resources, 12 ]
            - set: [ res_gunnery, 1 ]
            - set: [ src.busy, 4 ]
            - exec:
                Action: research_done
                Delay: 10
                ActionId: 1
        Dst:
          ObjectRules: lab
      - Src:
          ObjectRules: lab
          Preconditions:
            - eq: [ meta.tech, 5 ]
            - eq: [ src.busy, 0 ]
            - eq: [ res_vehicles, 0 ]
            - gte: [ player_resources, 12 ]
            - eq: [ res_armor, 2 ]
          Commands:
            - sub: [ player_resources, 12 ]
            - set: [ res_vehicles, 1 ]
            - set: [ src.busy, 5 ]
            - exec:
                Action: research_done
                Delay: 10
                ActionId: 1
        Dst:
          ObjectRules: lab

  # Internal: a lab finishes its current research project.
  - Name: research_done
    InputMapping:
      Internal: true
      Inputs:
        1: { VectorToDest: [ 0, 0 ] }
    Behaviours:
      - Src:
          ObjectRules: lab
          Commands:
            - eq:
                Arguments: [ src.busy, 1 ]
                Commands:
                  - set: [ res_mining, 2 ]
            - eq:
                Arguments: [ src.busy, 2 ]
                Commands:
                  - set: [ res_weapons, 2 ]
            - eq:
                Arguments: [ src.busy, 3 ]
                Commands:
                  - set: [ res_armor, 2 ]
            - eq:
                Arguments: [ src.busy, 4 ]
                Commands:
                  - set: [ res_gunnery, 2 ]
            - eq:
                Arguments: [ src.busy, 5 ]
                Commands:
                  - set: [ res_vehicles, 2 ]
            - set: [ src.busy, 0 ]
        Dst:
          ObjectRules: lab

  # Internal: a tank may move again.
  - Name: tank_ready
    InputMapping:
      Internal: true
      Inputs:
        1: { VectorToDest: [ 0, 0 ] }
    Behaviours:
      - Src:
          ObjectRules: tank
          Commands:
            - set: [ src.cooldown, 0 ]
        Dst:
          ObjectRules: tank

  # Internal: centre each player's camera on their base at the start of the game.
  - Name: init_camera
    InputMapping:
      Internal: true
      Inputs:
        1: { VectorToDest: [ 0, 0 ] }
    Behaviours:
      - Src:
          ObjectRules: base
          Commands:
            - set: [ cam_x, _x ]
            - set: [ cam_y, _y ]
        Dst:
          ObjectRules: base

Objects:
  - Name: minerals
    MapCharacter: M
    Variables:
      - Name: resources
        InitialValue: 15
    Observers:
      Sprite2D:
        - Image: oryx/oryx_tiny_galaxy/tg_sliced/tg_items/tg_items_crystal_green.png
          Scale: 1.0
        - Image: oryx/oryx_tiny_galaxy/tg_sliced/tg_items/tg_items_crystal_green.png
          Scale: 0.7
        - Image: oryx/oryx_tiny_galaxy/tg_sliced/tg_items/tg_items_crystal_green.png
          Scale: 0.4
      Block2D:
        - Shape: triangle
          Color: [ 0.0, 1.0, 0.0 ]
          Scale: 1.0
        - Shape: triangle
          Color: [ 0.0, 1.0, 0.0 ]
          Scale: 0.7
        - Shape: triangle
          Color: [ 0.0, 1.0, 0.0 ]
          Scale: 0.4


  - Name: worker
    MapCharacter: H
    Variables:
      - Name: carrying
        InitialValue: 0
      - Name: health
        InitialValue: 6
      - Name: damage
        InitialValue: 1
    Observers:
      Sprite2D:
        - Image: oryx/oryx_tiny_galaxy/tg_sliced/tg_monsters/tg_monsters_jelly_d1.png
      Block2D:
        - Shape: circle
          Color: PLAYER
          Scale: 0.5

  - Name: combat
    MapCharacter: c
    Variables:
      - Name: health
        InitialValue: 12
      - Name: damage
        InitialValue: 3
    Observers:
      Sprite2D:
        - Image: oryx/oryx_tiny_galaxy/tg_sliced/tg_monsters/tg_monsters_beast_d1.png
      Block2D:
        - Shape: pentagon
          Color: PLAYER
          Scale: 0.85

  - Name: marine
    MapCharacter: g
    Variables:
      - Name: health
        InitialValue: 8
      - Name: damage
        InitialValue: 2
    Observers:
      Sprite2D:
        - Image: oryx/oryx_tiny_galaxy/tg_sliced/tg_monsters/tg_monsters_marine_m_d1.png
      Block2D:
        - Shape: triangle
          Color: PLAYER
          Scale: 0.8

  - Name: tank
    MapCharacter: t
    Variables:
      - Name: health
        InitialValue: 30
      - Name: damage
        InitialValue: 5
      - Name: cooldown
        InitialValue: 0
    Observers:
      Sprite2D:
        - Image: oryx/oryx_tiny_galaxy/tg_sliced/tg_monsters/tg_monsters_robot_d1.png
      Block2D:
        - Shape: fill
          Color: PLAYER
          Scale: 0.75

  - Name: base
    MapCharacter: A
    Variables:
      - Name: health
        InitialValue: 40
    InitialActions:
      - Action: init_camera
        ActionId: 1
    Observers:
      Sprite2D:
        - Image: oryx/oryx_tiny_galaxy/tg_sliced/tg_world_fixed/img324.png
      Block2D:
        - Shape: hexagon
          Color: PLAYER
          Scale: 1.0

  - Name: barracks
    MapCharacter: B
    Variables:
      - Name: health
        InitialValue: 25
    Observers:
      Sprite2D:
        - Image: oryx/oryx_tiny_galaxy/tg_sliced/tg_world_fixed/img320.png
      Block2D:
        - Shape: square
          Color: PLAYER
          Scale: 1.0

  - Name: lab
    MapCharacter: L
    Variables:
      - Name: health
        InitialValue: 20
      - Name: busy
        InitialValue: 0
    Observers:
      Sprite2D:
        - Image: oryx/oryx_tiny_galaxy/tg_sliced/tg_items/tg_items_beaker_green.png
      Block2D:
        - Shape: circle
          Color: PLAYER
          Scale: 1.0

  - Name: fixed_wall
    MapCharacter: W
    Observers:
      Sprite2D:
        - TilingMode: WALL_2
          Image:
            - oryx/oryx_tiny_galaxy/tg_sliced/tg_world_fixed/img33.png
            - oryx/oryx_tiny_galaxy/tg_sliced/tg_world_fixed/img40.png
      Block2D:
        - Shape: square
          Color: [ 0.5, 0.5, 0.5 ]
Version: "0.1"
Environment:
  Name: GriddlyRTS
  Description: An RTS Game. There's aliens and stuff.
  Observers:
    Sprite2D:
      TileSize: 16
      BackgroundTile: oryx/oryx_tiny_galaxy/tg_sliced/tg_world/tg_world_floor_panel_metal_a.png
    Isometric:
      TileSize: [ 32, 48 ]
      BackgroundTile: oryx/oryx_iso_dungeon/floor-1.png
      IsoTileHeight: 16
      IsoTileDepth: 4
    Vector:
      IncludePlayerId: true
      IncludeVariables: true
  Variables:
    - Name: player_resources
      InitialValue: 0
      PerPlayer: true
  Player:
    Count: 2
  Termination:
    Lose:
      - Conditions:
          - eq: [ base:count, 0 ] # If the player has no bases
        Reward: -10 # -10 for a loss
        OpposingReward: 10 # as the agent didnt lose
