      M  .  .  .  .  .  .  .  .  .  .  .  F  F  .  .  W  .  .  .  .  .  .  .  .  .  .  w2 a2 .  .  M
      M  .  .  .  .  .  .  .  .  .  .  F  F  F  .  .  W  .  .  .  .  .  .  .  .  .  w2 a2 h2 .  .  M
      M  M  M  .  .  .  .  .  .  .  .  .  .  .  .  .  W  W  .  .  .  .  .  .  .  .  .  .  .  k2 .  M
      M  .  .  .  .  .  .  .  .  .  .  .  .  .  .  W  W  W  W  .  .  H  H  H  H  H  .  .  .  .  .  M
      M  .  .  .  .  .  .  .  .  .  .  .  .  .  W  W  W  W  W  W  .  .  .  .  .  .  .  .  .  .  .  M
      M  M  M  .  .  .  .  .  .  .  .  .  .  W  W  W  W  W  W  W  W  .  .  .  .  .  .  .  .  .  .  M
      M  .  .  .  .  .  .  .  .  .  .  .  W  W  W  W  W  W  W  W  W  W  .  .  .  .  .  .  .  .  .  M
      M  M  M  M  M  M  M  M  M  M  M  W  W  W  W  W  W  W  W  W  M  M  M  M  M  M  M  M  M  M  M  M

Actions:

  - Name: move_2
    InputMapping:
        Inputs:
          1:
            VectorToDest: [0, 1]
          2:
            VectorToDest: [0, 2]
          3:
            VectorToDest: [0, -1]
          4:
            VectorToDest: [0, -2]
          5:
            VectorToDest: [1, 0]
          6:
            VectorToDest: [2, 0]
          7:
            VectorToDest: [-1, 0]
          8:
            VectorToDest: [-2, 0]
    Behaviours:
      # Healer and warrior can move in empty space
      - Src:
          Object: [warrior, archer, healer]
          Commands:
            - mov: _dest
        Dst:
          Object: _empty

      # Healer and warrior can fall into holes
      - Src:
          Object: [warrior, archer, healer]
          Commands:
            - remove: true
        Dst:
          Object: hole

  - Name: move_1
    Behaviours:
      # Healer and warrior can move in empty space
      - Src:
