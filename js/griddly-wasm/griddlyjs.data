      Sprite2D: &water_sprite
        - Image: oryx/oryx_tiny_galaxy/tg_sliced/tg_world/tg_world_water.png
      EgoView: *water_sprite
      EgoClose: *water_sprite
      FollowCam: *water_sprite
      Block2D:
        - Shape: square
          Color: [0.1, 0.35, 0.7]
          Scale: 1.0
  - Name: rock
    MapCharacter: "#"
