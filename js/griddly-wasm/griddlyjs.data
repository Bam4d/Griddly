      wwwwwww
    - |
      wwwwww
      wh..ww
      wAbb.w
      ww...w
      www..w
      wwwwhw
      wwwwww
    - |
      wwwwwwww
      www.hhAw
      www.bb.w
      wwww.www
      wwww.www
