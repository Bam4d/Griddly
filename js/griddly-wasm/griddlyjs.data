      w   .   .   .   .   .   .   .   .   .   .   .   T   T   .   .   .   .   .   .   .   .   .   .   .   w
      w   .   .   .   .   .   w   w   w   w   .   .   .   .   .   .   .   .   w   w   w   w   .   .   .   w
      w   .   .   .   .   .   .   .   _   :   _   .   .   .   .   .   .   .   .   .   .   .   .   .   .   w
      w   .   B   .   .   .   .   _   :   :   :   _   A   .   .   .   .   .   .   .   .   .   .   B   _   w
