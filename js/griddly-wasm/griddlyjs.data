        - Image: gvgai/newset/blockG.png
      FollowCam: *green_box_sprite
      CloseUp: *green_box_sprite
      Block2D:
        - Shape: square
          Color: [0.2, 0.5, 0.2]
          Scale: 0.5
  - Name: green_block
    MapCharacter: "G"
    Z: 2
    Observers:
      Sprite2D: &green_block_sprite
        - Image: gvgai/newset/blockG2.png
      FollowCam: *green_block_sprite
      CloseUp: *green_block_sprite
      Block2D:
        - Shape: square
          Color: [0.0, 1.0, 0.0]
          Scale: 1.0
  - Name: blue_box
    MapCharacter: "u"
    Z: 2
    InitialActions:
      - Action: box_counter
        ActionId: 1
    Observers:
      Sprite2D: &blue_box_sprite
        - Image: gvgai/newset/blockB.png
      FollowCam: *blue_box_sprite
      CloseUp: *blue_box_sprite
      Block2D:
        - Shape: square
          Color: [0.2, 0.2, 0.5]
          Scale: 0.5
  - Name: blue_block
    MapCharacter: "U"
    Z: 2
    Observers:
      Sprite2D: &blue_block_sprite
        - Image: gvgai/newset/blockB2.png
      FollowCam: *blue_block_sprite
      CloseUp: *blue_block_sprite
      Block2D:
        - Shape: square
          Color: [0.0, 0.0, 1.0]
          Scale: 1.0
  - Name: broken_box
    Z: 2
    Observers:
      Sprite2D: &broken_box_sprite
        - Image: gvgai/newset/block3.png
      FollowCam: *broken_box_sprite
      CloseUp: *broken_box_sprite
      Block2D:
        - Shape: triangle
          Color: [1.0, 0.0, 1.0]
          Scale: 1.0
  - Name: avatar
    MapCharacter: "A"
    Z: 2
    InitialActions:
      - Action: face
        ActionId: 2
    Observers:
      Sprite2D: &avatar_sprite
        - Image: remastered/clusters-avatar-up.png
        - Image: remastered/clusters-avatar-right.png
        - Image: remastered/clusters-avatar-down.png
        - Image: remastered/clusters-avatar-left.png
      FollowCam: *avatar_sprite
      CloseUp: *avatar_sprite
      Block2D:
        - Shape: triangle
          Color: [0.0, 1.0, 0.0]
          Scale: 0.8
        - Shape: triangle
          Color: [0.0, 1.0, 0.0]
          Scale: 0.8
        - Shape: triangle
          Color: [0.0, 1.0, 0.0]
          Scale: 0.8
        - Shape: triangle
          Color: [0.0, 1.0, 0.0]
          Scale: 0.8
Version: "0.1"
Environment:
  Name: Cook Me Pasta Remastered
  Description: |
    Help the chef cook pasta! Push boiling water into raw pasta to cook it, push tomato into tuna for
    the sauce, then push the cooked pasta and the sauce together to serve the meal. Mixing a pasta
    ingredient with a sauce ingredient ruins the dish. Keys open locked doors (one key per lock).
    Generated by studio/griddly-demo/tools/remaster â€” edit the generator, not this file.
  # Cameras are observers. The demo picks one by name and the engine renders it.
  #   Sprite2D   whole level (global observer)
  #   FollowCam  15x11 window that follows the avatar
  #   CloseUp    9x9 window that follows the avatar (also the agent's default view)
  Observers:
    Sprite2D:
      TileSize: 24
      BackgroundTile: gvgai/newset/floor6.png
      RotateAvatarImage: false
      TrackAvatar: false
    FollowCam:
      Type: SPRITE_2D
      TileSize: 24
      BackgroundTile: gvgai/newset/floor6.png
      RotateAvatarImage: false
      RotateWithAvatar: false
      TrackAvatar: true
      Width: 15
      Height: 11
    CloseUp:
      Type: SPRITE_2D
      TileSize: 24
      BackgroundTile: gvgai/newset/floor6.png
      RotateAvatarImage: false
      RotateWithAvatar: false
      TrackAvatar: true
      Width: 9
      Height: 9
    Block2D:
      TileSize: 24
  Player:
    Observer:
      TrackAvatar: true
      RotateWithAvatar: false
      RotateAvatarImage: false
      Width: 9
      Height: 9
    AvatarObject: chef
  Termination:
    Win:
      - eq: [complete_meal:count, 1]
    Lose:
      - eq: [wrong_place:count, 1]
  Levels:
    # Trattoria | Boil the pasta, mix the sauce, plate the meal.
    - |
      w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w
      w   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   w
      w   .   .   p   .   .   .   .   .   .   .   .   T   T   .   .   .   .   .   .   .   o   .   .   .   w
      w   .   .   .   .   .   .   .   .   .   .   .   T   T   .   .   .   .   .   .   .   .   .   .   .   w
      w   .   .   .   .   .   w   w   w   w   .   .   .   .   .   .   .   .   w   w   w   w   .   .   .   w
      w   .   .   .   .   .   .   .   _   :   _   .   .   .   .   .   .   .   .   .   .   .   .   .   .   w
      w   .   B   .   .   .   .   _   :   :   :   _   A   .   .   .   .   .   .   .   .   .   .   B   _   w
      w   .   .   .   .   .   .   .   _   _   .   .   .   .   .   .   .   .   .   .   .   .   _   _   _   w
      w   :   .   .   .   .   w   w   w   w   .   .   .   .   .   .   .   .   w   w   w   w   _   _   _   w
      w   :   :   .   .   .   .   .   .   .   .   .   T   T   .   .   .   .   .   .   .   .   _   _   _   w
      w   :   .   b   .   .   .   .   .   .   .   .   T   T   .   .   .   .   .   .   .   t   .   _   _   w
      w   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   w
      w   .   |   .   .   .   .   .   .   .   .   .   B   .   .   .   .   .   .   .   .   .   .   |   .   w
      w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w
