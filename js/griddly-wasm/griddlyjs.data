          Scale: 0.9
        - Shape: triangle
          Color: [0.0, 0.5, 0.5]
          Scale: 0.9
        - Shape: triangle
          Color: [0.0, 0.5, 0.5]
          Scale: 0.9
        - Shape: triangle
          Color: [0.0, 0.5, 0.5]
          Scale: 0.9
  - Name: attack_fire
    Z: 3
    InitialActions:
      - Action: fade
        ActionId: 1
        Delay: 3
    Observers:
      Sprite2D: &attack_fire_sprite
        - Image: gvgai/oryx/fire1.png
      FollowCam: *attack_fire_sprite
      CloseUp: *attack_fire_sprite
      Block2D:
        - Shape: square
          Color: [1.0, 0.3, 0.0]
          Scale: 0.5
Version: "0.1"
Environment:
  Name: Zen Puzzle Remastered
  Description: |
    Rake every stone tile of the zen garden's patterns, but never step on a tile twice. Walk freely
    over the sand, grass and moss around the patterns; rocks, lanterns, ponds, trees and bushes block
    the way. You win when every tile is raked; you lose after 1000 steps.
    Generated by studio/griddly-demo/tools/remaster â€” edit the generator, not this file.
  # Cameras are observers. The demo picks one by name and the engine renders it.
  #   Sprite2D   whole level (global observer)
  #   FollowCam  15x11 window that follows the avatar
  #   CloseUp    9x9 window that follows the avatar (also the agent's default view)
  Observers:
    Sprite2D:
      TileSize: 24
      BackgroundTile: oryx/oryx_fantasy/floor3-0.png
      RotateAvatarImage: false
      TrackAvatar: false
    FollowCam:
      Type: SPRITE_2D
      TileSize: 24
      BackgroundTile: oryx/oryx_fantasy/floor3-0.png
      RotateAvatarImage: false
      RotateWithAvatar: false
      TrackAvatar: true
      Width: 15
      Height: 11
    CloseUp:
      Type: SPRITE_2D
      TileSize: 24
      BackgroundTile: oryx/oryx_fantasy/floor3-0.png
      RotateAvatarImage: false
      RotateWithAvatar: false
      TrackAvatar: true
      Width: 9
      Height: 9
    Block2D:
      TileSize: 24
  Player:
    Observer:
      TrackAvatar: true
      RotateWithAvatar: false
      RotateAvatarImage: false
      Width: 9
      Height: 9
    AvatarObject: monk
  Termination:
    Win:
      - eq: [ground:count, 0]
    Lose:
      - eq: [_steps, 1000]
  Levels:
    # Raked Sand | One stone slab, two lanterns. Rake every tile exactly once.
    - |
      $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $
      $   .   .   .   .   .   ,   ,   ,   ,   ,   &   _   _   _   _   |   ,   &   .   .   .   .   $
      $   .   .   %   .   .   |   ,   ,   ,   ,   ,   _   _   _   .   _   .   .   .   .   ,   &   $
      $   .   .   .   .   .   .   _   ,   .   ,   _   _   _   .   .   _   .   .   .   .   .   .   $
      $   .   .   .   .   ,   %   ,   g   g   g   g   g   g   g   g   .   .   _   _   .   .   .   $
      $   .   .   .   &   ,   _   _   g   g   g   g   g   g   g   g   .   _   *   _   _   ,   .   $
      $   .   .   .   ,   _   .   _   g   g   r   g   g   r   g   g   .   ,   %   ,   ,   ,   ,   $
      $   .   .   A   .   .   %   ,   g   g   g   g   g   g   g   g   ,   %   ,   ,   ,   &   ,   $
      $   .   .   .   .   .   ,   .   g   g   g   r   g   g   g   g   .   _   ,   _   ,   ,   ,   $
      $   .   .   _   _   _   .   .   g   g   g   g   g   g   g   g   _   _   _   _   ,   ,   .   $
      $   .   .   _   _   _   .   .   .   .   .   .   ,   .   _   _   _   *   ,   ,   %   _   .   $
      $   .   .   .   _   _   .   .   .   .   .   .   %   .   _   ,   %   ,   &   ,   .   .   .   $
      $   .   .   .   .   .   .   .   .   .   .   .   ,   .   .   .   ,   .   .   .   .   .   .   $
      $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $
    # Twin Stones | Two patterns side by side, around a little pond.
    - |
      $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $
      $   .   .   ,   ,   ,   ,   ,   ,   ,   &   .   .   .   .   ,   .   .   .   .   .   _   _   .   .   .   .   $
      $   .   ,   ,   ;   ,   ,   ,   ,   .   .   .   .   A   ,   %   ,   %   %   ,   _   _   _   _   _   .   .   $
      $   .   ;   ,   ,   ,   ,   ,   .   .   .   .   .   .   .   .   .   ,   .   .   .   .   _   _   _   .   .   $
      $   .   _   ;   g   g   g   g   g   g   g   .   .   .   .   .   .   g   g   g   g   g   g   .   _   .   .   $
      $   %   ,   _   g   r   g   g   g   r   g   ,   .   ,   .   .   .   g   g   r   g   g   g   .   ,   .   .   $
      $   ,   _   _   g   g   g   g   g   g   g   ,   ,   %   ,   .   .   g   g   g   g   g   g   _   %   _   ,   $
      $   _   _   _   g   g   g   r   g   g   g   ,   _   _   .   .   .   g   g   g   g   g   r   .   _   _   &   $
      $   ,   .   .   g   g   g   g   g   g   g   _   _   _   |   .   .   g   g   g   g   g   g   _   _   .   ,   $
      $   &   ,   .   .   _   _   _   _   _   _   _   _   _   _   _   ,   g   g   r   g   g   g   _   .   .   .   $
      $   ,   .   %   &   _   _   _   .   _   _   _   _   _   _   ,   _   .   .   .   .   .   ;   ;   .   .   .   $
      $   .   ,   ,   .   .   ,   .   _   _   _   _   ~   ~   ~   ,   ,   ,   .   .   .   |   ,   ;   _   .   .   $
      $   ,   &   ,   .   .   &   ,   .   _   ,   _   ~   ~   ~   ,   ,   ,   .   .   ,   ,   ,   ;   .   &   .   $
      $   .   ,   .   .   .   .   .   .   ,   &   ,   ~   ~   ~   .   .   .   |   %   ,   ,   .   .   .   ,   .   $
      $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $
    # Koi Pond | A ring of tiles around the koi pond â€” plan your laps.
    - |
      &   &   &   &   &   &   &   &   &   &   &   &   &   &   &   &   &   &   &   &   &   &   &   &   &   &   &   &
      &   ,   .   ,   ,   ,   ,   ,   ,   ,   .   ,   ,   ;   ,   .   ;   ,   ;   .   .   ,   ,   ,   ,   ,   ,   &
      &   ,   A   ,   ,   ,   ,   ,   ,   ,   .   ,   ;   ;   .   .   .   ;   ;   *   .   g   g   g   g   g   ,   &
      &   &   ,   ,   ,   ,   ,   .   ,   ,   ,   %   ,   ,   _   _   ;   ;   .   .   .   g   g   r   g   g   ,   &
      &   %   ,   ,   ,   ,   &   _   _   _   .   .   ,   ,   ,   _   .   .   .   .   .   g   g   g   g   g   ;   &
      &   ,   ,   ,   *   ,   ,   ;   _   g   g   g   g   g   g   g   g   g   g   .   .   .   .   .   .   .   ,   &
      &   .   ,   .   ,   .   ,   _   ;   g   g   r   g   g   g   g   r   g   g   .   .   .   .   .   .   .   .   &
      &   ,   .   .   ,   %   ,   ;   ;   g   g   ~   ~   ~   ~   ~   ~   g   g   .   .   .   .   .   .   .   .   &
      &   .   .   .   ,   &   ,   ;   ;   g   g   ~   ~   ~   ~   ~   ~   g   g   _   .   .   .   ,   ,   *   ,   &
      &   |   .   .   .   .   ,   %   ;   g   g   ~   ~   ~   ~   ~   ~   g   g   _   _   _   ,   ,   ,   ,   ,   &
      &   .   .   .   .   .   .   ,   .   g   g   r   g   g   g   g   r   g   g   _   _   _   .   .   ,   ,   ,   &
      &   .   .   .   .   .   .   .   .   g   g   g   g   g   g   g   g   g   g   _   .   _   .   .   ,   .   &   &
      &   ,   ~   ~   ~   ,   .   ,   .   ,   .   .   .   .   ,   ,   _   ,   _   _   |   _   .   .   .   .   ,   &
      &   .   ~   ~   ~   %   ,   %   ,   &   .   .   ,   ,   &   ,   ,   .   _   _   _   ,   &   ,   &   ,   ,   &
      &   ,   ,   ~   ~   .   .   .   .   %   ,   .   ,   .   ,   ,   ,   ,   _   _   .   .   ,   %   ,   %   ,   &
      &   ,   ,   ,   %   ,   ,   ,   .   ,   .   ,   .   .   ,   &   ,   .   ,   ,   .   ,   &   ,   ,   ,   ,   &
      &   &   &   &   &   &   &   &   &   &   &   &   &   &   &   &   &   &   &   &   &   &   &   &   &   &   &   &
    # Lantern Cross | A cross of tiles between stone lanterns, plus two small slabs.
    - |
