        - Image: gvgai/oryx/skull1.png
      GnomeCam: *skull_sprite
      GnomeCloseUp: *skull_sprite
      Block2D:
        - Shape: circle
          Color: [0.9, 0.9, 0.9]
          Scale: 0.3
  - Name: bush
    MapCharacter: 'b'
    Z: 1
    Observers:
      Sprite2D: &bush_sprite
        - Image: gvgai/oryx/bush1.png
      GnomeCam: *bush_sprite
      GnomeCloseUp: *bush_sprite
      Block2D:
        - Shape: circle
          Color: [0.1, 0.45, 0.15]
          Scale: 0.8
  - Name: tree
    MapCharacter: 'T'
    Z: 1
    Observers:
      Sprite2D: &tree_sprite
        - Image: gvgai/oryx/tree2.png
      GnomeCam: *tree_sprite
      GnomeCloseUp: *tree_sprite
      Block2D:
        - Shape: circle
          Color: [0.05, 0.4, 0.2]
          Scale: 0.9
  - Name: tombstone
    MapCharacter: 't'
    Z: 1
    Observers:
      Sprite2D: &tombstone_sprite
        - Image: gvgai/oryx/tombstone1.png
      GnomeCam: *tombstone_sprite
      GnomeCloseUp: *tombstone_sprite
      Block2D:
        - Shape: square
          Color: [0.5, 0.5, 0.5]
          Scale: 0.7
  - Name: torch
    MapCharacter: 'i'
    Z: 1
    Observers:
      Sprite2D: &torch_sprite
        - Image: gvgai/oryx/torch1.png
      GnomeCam: *torch_sprite
      GnomeCloseUp: *torch_sprite
      Block2D:
        - Shape: circle
          Color: [1.0, 0.6, 0.1]
          Scale: 0.5
  - Name: nest
    MapCharacter: 'N'
    Z: 1
    Variables:
      - Name: hatched
        InitialValue: 0
    InitialActions:
      - Action: hatch
        Delay: 40
        Randomize: true
    Observers:
      Sprite2D: &nest_sprite
        - Image: gvgai/newset/cocoonb1.png
      GnomeCam: *nest_sprite
      GnomeCloseUp: *nest_sprite
      Block2D:
        - Shape: circle
          Color: [0.6, 0.6, 0.5]
          Scale: 0.7
  - Name: key
    MapCharacter: 'K'
    Z: 1
    Observers:
      Sprite2D: &key_sprite
        - Image: oryx/oryx_fantasy/key-0.png
      GnomeCam: *key_sprite
      GnomeCloseUp: *key_sprite
      Block2D:
        - Shape: triangle
          Color: [1.0, 0.85, 0.1]
          Scale: 0.5
  - Name: gem
    MapCharacter: 'g'
    Z: 1
    Observers:
      Sprite2D: &gem_sprite
        - Image: oryx/oryx_fantasy/ore-6.png
      GnomeCam: *gem_sprite
      GnomeCloseUp: *gem_sprite
      Block2D:
        - Shape: triangle
          Color: [0.0, 1.0, 0.0]
          Scale: 0.5
  - Name: spider
    MapCharacter: 'G'
    Z: 2
    InitialActions:
      - Action: random_movement
        Delay: 3
        Randomize: true
    Observers:
      Sprite2D: &spider_sprite
        - Image: oryx/oryx_fantasy/avatars/spider1.png
      GnomeCam: *spider_sprite
      GnomeCloseUp: *spider_sprite
      Block2D:
        - Shape: triangle
          Color: [1.0, 0.0, 0.0]
          Scale: 0.8
  - Name: gnome
    MapCharacter: 'A'
    Z: 2
    Variables:
      - Name: keys
        InitialValue: 0
    InitialActions:
      - Action: face
        ActionId: 2
    Observers:
      Sprite2D: &gnome_sprite
        - Image: spiders-garden/gnome-up.png
        - Image: spiders-garden/gnome-right.png
        - Image: spiders-garden/gnome-down.png
        - Image: spiders-garden/gnome-left.png
      GnomeCam: *gnome_sprite
      GnomeCloseUp: *gnome_sprite
      Block2D:
        - Shape: triangle
          Color: [0.0, 0.0, 1.0]
          Scale: 0.8
        - Shape: triangle
          Color: [0.0, 0.0, 1.0]
          Scale: 0.8
        - Shape: triangle
          Color: [0.0, 0.0, 1.0]
          Scale: 0.8
        - Shape: triangle
          Color: [0.0, 0.0, 1.0]
          Scale: 0.8
Version: "0.1"
Environment:
  Name: Spiders
  Description: A port of the games provided in the https://github.com/maximecb/gym-minigrid Dynamic obstacles environment, but you're a gnome avoiding ghosts to get to a gem.
  Observers:
    Sprite2D:
      TileSize: 24
      BackgroundTile: oryx/oryx_fantasy/floor2-2.png
    Isometric:
      TileSize: [32, 48]
      IsoTileHeight: 16
      IsoTileDepth: 4
      BackgroundTile: oryx/oryx_iso_dungeon/grass-1.png
    Block2D:
      TileSize: 24
  Player:
    Observer:
      RotateWithAvatar: true
      TrackAvatar: true
      Height: 7
      Width: 7
      OffsetX: 0
      OffsetY: 3
    AvatarObject: gnome
  Termination:
    Win:
      - eq: [gem:count, 0] # If there are no boxes left
    Lose:
      - eq: [gnome:count, 0] # If there are no boxes left
  Levels:
    - |
      W  W  W  W  W  W
      W  A  .  .  .  W
      W  .  .  .  .  W
      W  .  G  .  .  W
      W  .  .  .  g  W
      W  W  W  W  W  W
    - |
      W  W  W  W  W  W  W
      W  A  .  .  .  .  W
      W  .  .  .  .  .  W
      W  .  .  G  .  .  W
      W  .  .  .  .  .  W
      W  .  G  .  .  g  W
      W  W  W  W  W  W  W
    - |
      W  W  W  W  W  W  W  W
      W  A  .  .  .  .  .  W
      W  .  .  .  .  G  .  W
      W  .  .  .  .  .  .  W
      W  .  G  .  G  .  .  W
      W  .  .  .  .  .  .  W
      W  .  .  .  .  .  g  W
      W  W  W  W  W  W  W  W
    - |
      W  W  W  W  W  W  W  W  W  W
      W  A  .  .  .  .  .  .  .  W
      W  .  .  G  .  .  .  .  .  W
      W  .  .  .  .  .  .  G  .  W
      W  .  .  .  .  .  .  .  .  W
      W  .  .  .  .  G  .  .  .  W
      W  .  G  .  .  .  .  .  .  W
      W  .  .  .  .  .  .  .  .  W
      W  .  .  .  .  .  .  .  g  W
      W  W  W  W  W  W  W  W  W  W
    - |
      W  W  W  W  W  W  W  W  W  W  W  W  W  W  W  W  W  W  W
      W  A  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  W
      W  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  W
      W  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  W
      W  .  .  G  .  .  .  .  .  .  .  .  .  .  .  .  .  .  W
      W  .  .  .  .  .  .  .  .  .  .  G  .  .  .  .  .  .  W
      W  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  W
      W  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  W
      W  .  .  G  .  .  .  .  .  G  .  .  .  .  .  G  .  .  W
      W  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  W
      W  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  W
      W  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  W
      W  .  .  .  .  .  G  .  .  .  .  .  .  .  .  .  .  .  W
      W  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  W
