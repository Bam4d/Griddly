        - Shape: triangle
          Color: [1.0, 0.0, 0.0]
          Scale: 0.3

  - Name: wall
    MapCharacter: w
    Observers:
      Sprite2D:
        - TilingMode: WALL_16
          Image:
            - oryx/oryx_fantasy/wall8-0.png
            - oryx/oryx_fantasy/wall8-1.png
