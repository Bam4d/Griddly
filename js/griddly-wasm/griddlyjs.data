      $     ,     ,     .     %     %     %     ,     .     ,     .     T     ,     ,/o   ,     ,     ,     ,     .     ,     %     %     %     _     .     .     $
      $     ,     .     .     ,     ,     ,     ,     ,     r     _     _     _     _/G[R] _     _     _     r     .     ,     ,     ,     ,     _     .     T     $
