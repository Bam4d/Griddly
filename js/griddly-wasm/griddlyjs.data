          Color: [0.7, 0.7, 0.7]
          Scale: 1.0
      Isometric:
        - Image: oryx/oryx_iso_dungeon/bush-1.png

  - Name: spider
    InitialActions:
      - Action: random_movement
        Delay: 3
        Randomize: true
    MapCharacter: G
    Observers:
      Sprite2D:
        - Image: oryx/oryx_fantasy/avatars/spider1.png
      Block2D:
        - Shape: triangle
          Color: [1.0, 0.0, 0.0]
          Scale: 0.8
      Isometric:
        - Image: oryx/oryx_iso_dungeon/avatars/spider-1.png

  - Name: gem
    MapCharacter: g
    Observers:
      Sprite2D:
        - Image: oryx/oryx_fantasy/ore-6.png
      Block2D:
        - Shape: triangle
          Color: [0.0, 1.0, 0.0]
          Scale: 0.5
      Isometric:
        - Image: oryx/oryx_iso_dungeon/ore-6.png

  - Name: gnome
    MapCharacter: A
    Observers:
      Sprite2D:
        - Image: oryx/oryx_fantasy/avatars/gnome1.png
      Block2D:
        - Shape: triangle
          Color: [0.0, 0.0, 1.0]
          Scale: 0.8
      Isometric:
        - Image: oryx/oryx_iso_dungeon/avatars/gnome-1.pngVersion: "0.1"
Environment:
  Name: Bait Remastered
  Description: |
    Get the key and unlock the door. Pits block the way: push boxes into them to fill them in, and
    never step into one yourself. Toadstools are a tasty bonus. Walls, water, hedges, trees, rocks
    and tombstones block boxes; grass, sand, moss and dirt don't.
    Generated by studio/griddly-demo/tools/remaster â€” edit the generator, not this file.
  # Cameras are observers. The demo picks one by name and the engine renders it.
  #   Sprite2D   whole level (global observer)
  #   FollowCam  15x11 window that follows the avatar
  #   CloseUp    9x9 window that follows the avatar (also the agent's default view)
  Observers:
    Sprite2D:
      TileSize: 24
      BackgroundTile: gvgai/oryx/backLBrown.png
      RotateAvatarImage: false
      TrackAvatar: false
    FollowCam:
      Type: SPRITE_2D
      TileSize: 24
      BackgroundTile: gvgai/oryx/backLBrown.png
      RotateAvatarImage: false
      RotateWithAvatar: false
      TrackAvatar: true
      Width: 15
      Height: 11
    CloseUp:
      Type: SPRITE_2D
      TileSize: 24
      BackgroundTile: gvgai/oryx/backLBrown.png
      RotateAvatarImage: false
      RotateWithAvatar: false
      TrackAvatar: true
      Width: 9
      Height: 9
    Block2D:
      TileSize: 24
  Player:
    Observer:
      TrackAvatar: true
      RotateWithAvatar: false
      RotateAvatarImage: false
      Width: 9
      Height: 9
    AvatarObject: avatar
  Termination:
    Win:
      - eq: [goal:count, 0]
    Lose:
      - eq: [avatar:count, 0]
  Levels:
    # Cellar Door | A pit guards the key. Fill it, grab the key, open the door.
    - |
      w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w
      w   .   .   .   .   .   |   w   w   .   .   .   .   .   .   w   w   _   _   .   .   .   .   w
      w   .   .   .   .   .   .   w   w   k   .   .   .   .   :   :   _   _/h _   _   .   .   .   w
      w   .   .   .   .   .   g   w   w   .   .   .   .   .   :   w   w   _   _   _   .   .   .   w
      w   .   b   .   .   .   .   w   w   +   .   .   .   .   @   w   w   .   _   .   .   .   m   w
      w   w   .   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   .   w   w   w   w
      w   w   .   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   .   w   w   w   w
      w   .   .   .   :   :   .   w   w   A   _   .   _   :   :   .   .   .   .   .   .   +   m   w
      w   .   .   .   :   .   :   w   w   _   .   .   :   :   :   w   w   .   .   .   .   .   .   w
