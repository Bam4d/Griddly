        - Shape: square
          Color: [0.55, 0.4, 0.25]
          Scale: 0.9
  - Name: water
    MapCharacter: "~"
    Z: 1
    Observers:
      Sprite2D: &water_sprite
        - Image: oryx/oryx_tiny_galaxy/tg_sliced/tg_world/tg_world_water.png
      FollowCam: *water_sprite
      CloseUp: *water_sprite
      Block2D:
        - Shape: square
          Color: [0.1, 0.35, 0.7]
          Scale: 1.0
  - Name: tree
    MapCharacter: "&"
