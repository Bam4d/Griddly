Actions:
  - Name: face
    InputMapping:
      Internal: true
      Inputs:
        2: {Description: Face down, VectorToDest: [0, 0], MetaData: {facing: 2}}
    Behaviours:
      - Src: {Object: drunk_dwarf, Commands: [{set_tile: meta.facing}]}
        Dst: {Object: drunk_dwarf}

  # The dwarf stumbles up / down / left / right (absolute). Keys are picked up by walking into them;
  # walking into a locked door while holding a key uses the key up and unlocks the door.
  - Name: move
    InputMapping:
      Inputs:
        1: {Description: Left, VectorToDest: [-1, 0], MetaData: {facing: 3}}
        2: {Description: Up, VectorToDest: [0, -1], MetaData: {facing: 0}}
        3: {Description: Right, VectorToDest: [1, 0], MetaData: {facing: 1}}
        4: {Description: Down, VectorToDest: [0, 1], MetaData: {facing: 2}}
    Behaviours:
      - Src: {Object: drunk_dwarf, Commands: [{set_tile: meta.facing}, {mov: _dest}]}
        Dst: {Object: [_empty, grass, moss, dirt, sand, bones, mushroom, skull, bridge, open_door]}
      - Src: {Object: drunk_dwarf, Commands: [{set_tile: meta.facing}, {reward: 1}]}
        Dst: {Object: coffin_bed, Commands: [{remove: true}]}
      - Src: {Object: drunk_dwarf, Commands: [{set_tile: meta.facing}, {mov: _dest}, {incr: keys}, {reward: 1}]}
        Dst: {Object: key, Commands: [{remove: true}]}
      - Src:
          Object: drunk_dwarf
          Preconditions: [{gte: [src.keys, 1]}]
          Commands: [{set_tile: meta.facing}, {decr: keys}, {reward: 1}]
        Dst: {Object: door, Commands: [{change_to: open_door}]}
      - Src: {Object: drunk_dwarf, Commands: [{set_tile: meta.facing}]}
        Dst: {Object: [wall, chair, table, bookshelf, barrel, doggo, water, tree, bush, rock, hedge, stone, tombstone, torch]}

Objects:
  - Name: grass
    MapCharacter: ","
    Z: 0
    Observers:
      Sprite2D: &grass_sprite
        - TilingMode: WALL_16
          Image:
            - gvgai/oryx/grass_0.png
            - gvgai/oryx/grass_1.png
            - gvgai/oryx/grass_2.png
            - gvgai/oryx/grass_3.png
            - gvgai/oryx/grass_4.png
            - gvgai/oryx/grass_5.png
            - gvgai/oryx/grass_6.png
            - gvgai/oryx/grass_7.png
            - gvgai/oryx/grass_8.png
            - gvgai/oryx/grass_9.png
            - gvgai/oryx/grass_10.png
            - gvgai/oryx/grass_11.png
            - gvgai/oryx/grass_12.png
            - gvgai/oryx/grass_13.png
            - gvgai/oryx/grass_14.png
            - gvgai/oryx/grass_15.png
      FollowCam: *grass_sprite
      CloseUp: *grass_sprite
      Block2D:
        - Shape: square
          Color: [0.25, 0.55, 0.25]
          Scale: 0.9
  - Name: moss
    MapCharacter: ";"
    Z: 0
    Observers:
      Sprite2D: &moss_sprite
        - Image: oryx/oryx_tiny_galaxy/tg_sliced/tg_world/tg_world_floor_moss_a.png
      FollowCam: *moss_sprite
      CloseUp: *moss_sprite
      Block2D:
        - Shape: square
          Color: [0.25, 0.4, 0.2]
          Scale: 0.9
  - Name: dirt
    MapCharacter: ":"
    Z: 0
    Observers:
      Sprite2D: &dirt_sprite
        - Image: oryx/oryx_tiny_galaxy/tg_sliced/tg_world/tg_world_floor_dirt_a.png
      FollowCam: *dirt_sprite
      CloseUp: *dirt_sprite
      Block2D:
        - Shape: square
          Color: [0.3, 0.22, 0.15]
          Scale: 0.9
  - Name: sand
    MapCharacter: "_"
    Z: 0
    Observers:
      Sprite2D: &sand_sprite
        - Image: oryx/oryx_tiny_galaxy/tg_sliced/tg_world/tg_world_floor_sand_a.png
      FollowCam: *sand_sprite
      CloseUp: *sand_sprite
      Block2D:
        - Shape: square
          Color: [0.7, 0.55, 0.3]
          Scale: 0.9
  - Name: bones
    MapCharacter: "+"
    Z: 0
    Observers:
      Sprite2D: &bones_sprite
        - Image: oryx/oryx_tiny_galaxy/tg_sliced/tg_world/tg_world_bones_a.png
      FollowCam: *bones_sprite
      CloseUp: *bones_sprite
      Block2D:
        - Shape: square
          Color: [0.8, 0.8, 0.75]
          Scale: 0.9
  - Name: mushroom
    MapCharacter: "*"
    Z: 0
    Observers:
      Sprite2D: &mushroom_sprite
        - Image: gvgai/oryx/mushroom2.png
      FollowCam: *mushroom_sprite
      CloseUp: *mushroom_sprite
      Block2D:
        - Shape: square
          Color: [0.8, 0.2, 0.2]
          Scale: 0.9
  - Name: skull
    MapCharacter: "^"
    Z: 0
    Observers:
      Sprite2D: &skull_sprite
        - Image: gvgai/oryx/skull1.png
      FollowCam: *skull_sprite
      CloseUp: *skull_sprite
      Block2D:
        - Shape: square
          Color: [0.9, 0.9, 0.9]
          Scale: 0.9
  - Name: bridge
    MapCharacter: "="
    Z: 0
    Observers:
      Sprite2D: &bridge_sprite
        - Image: gvgai/newset/logm.png
      FollowCam: *bridge_sprite
      CloseUp: *bridge_sprite
      Block2D:
        - Shape: square
          Color: [0.55, 0.4, 0.25]
          Scale: 0.9
  - Name: water
    MapCharacter: "~"
    Z: 1
    Observers:
      Sprite2D: &water_sprite
        - Image: oryx/oryx_tiny_galaxy/tg_sliced/tg_world/tg_world_water.png
      FollowCam: *water_sprite
      CloseUp: *water_sprite
      Block2D:
        - Shape: square
          Color: [0.1, 0.35, 0.7]
          Scale: 1.0
  - Name: tree
    MapCharacter: "&"
    Z: 1
    Observers:
      Sprite2D: &tree_sprite
        - Image: gvgai/oryx/tree2.png
      FollowCam: *tree_sprite
      CloseUp: *tree_sprite
      Block2D:
        - Shape: square
          Color: [0.05, 0.4, 0.2]
          Scale: 1.0
  - Name: bush
    MapCharacter: "%"
    Z: 1
    Observers:
      Sprite2D: &bush_sprite
        - Image: gvgai/oryx/bush1.png
      FollowCam: *bush_sprite
      CloseUp: *bush_sprite
      Block2D:
        - Shape: square
          Color: [0.1, 0.45, 0.15]
          Scale: 1.0
  - Name: rock
    MapCharacter: "#"
    Z: 1
