      R   R   R   R   R   R   R   d   .   .   .   .   .   .   .   d   d   .   .   .   R   R   R   R   R   R   R   R   R   R   R   R   x   .   .   N   .   R
      R   R   R   R   R   R   R   R   .   .   o   R   R   .   .   .   o   .   .   R   R   R   R   R   R   R   R   R   R   R   R   R   .   .   o   .   .   R
      R   R   R   R   R   R   R   R   R   R   R   R   R   R   .   .   .   .   .   R   R   R   R   R   R   R   R   R   R   R   R   R   .   .   .   .   .   R
      R   R   R   R   R   R   R   R   R   R   R   R   R   R   R   .   .   g   G   R   R   R   R   R   R   R   R   R   R   R   R   R   R   R   R   R   R   R
      R   R   R   R   R   R   R   R   R   R   R   R   R   R   R   R   R   R   R   R   R   R   R   R   R   R   R   R   R   R   R   R   R   R   R   R   R   R

Actions:
  # Spiders wander: rotate left/right or step forwards, at random.
  - Name: random_movement
    InputMapping:
      Inputs:
        1: {Description: Rotate left, OrientationVector: [-1, 0]}
        2: {Description: Move forwards, OrientationVector: [0, -1], VectorToDest: [0, -1]}
        3: {Description: Rotate right, OrientationVector: [1, 0]}
      Relative: true
      Internal: true
    Behaviours:
      - Src: {Object: spider, Commands: [{rot: _dir}, {exec: {Action: random_movement, Delay: 3, Randomize: true}}]}
        Dst: {Object: spider}
      - Src: {Object: spider, Commands: [{mov: _dest}, {exec: {Action: random_movement, Delay: 3, Randomize: true}}]}
        Dst: {Object: _empty}
      - Src: {Object: spider, Commands: [{mov: _dest}, {exec: {Action: random_movement, Delay: 3, Randomize: true}}]}
        Dst: {Object: [grass, moss, dirt, bones, mushroom, skull, bridge]}
      - Src: {Object: spider, Commands: [{exec: {Action: random_movement, Delay: 3, Randomize: true}}]}
        Dst: {Object: [wall, hedge, rock, water, door, bush, tree, tombstone, torch, nest, gem, key]}
      - Src: {Object: spider}
        Dst: {Object: gnome, Commands: [{remove: true}, {reward: -1}]}

  # Nests hatch up to 2 spiders each, into a random neighbouring cell.
  - Name: hatch
    InputMapping:
      Internal: true
    Behaviours:
      - Src:
          Object: nest
          Preconditions: [{lt: [src.hatched, 2]}]
          Commands: [{spawn: spider}, {incr: hatched}, {exec: {Action: hatch, Delay: 60, Randomize: true}}]
        Dst: {Object: _empty}
      - Src:
          Object: nest
          Preconditions: [{lt: [src.hatched, 2]}]
          Commands: [{spawn: spider}, {incr: hatched}, {exec: {Action: hatch, Delay: 60, Randomize: true}}]
        Dst: {Object: [grass, moss, dirt, bones, mushroom, skull, bridge]}
      - Src:
          Object: nest
          Preconditions: [{lt: [src.hatched, 2]}]
          Commands: [{exec: {Action: hatch, Delay: 10, Randomize: true}}]
        Dst: {Object: [wall, hedge, rock, water, door, bush, tree, tombstone, torch, nest, gem, key, spider, gnome]}

  # Start the gnome facing down (render tile 2).
  - Name: face
    InputMapping:
      Internal: true
      Inputs:
        2: {Description: Face down, VectorToDest: [0, 0], MetaData: {facing: 2}}
    Behaviours:
      - Src: {Object: gnome, Commands: [{set_tile: meta.facing}]}
        Dst: {Object: gnome}

  # The gnome moves up / down / left / right (absolute; it never rotates). MetaData.facing picks the
  # gnome's render tile (set_tile) so every observer shows which way it last moved.
  - Name: move
    InputMapping:
      Inputs:
        1: {Description: Left, VectorToDest: [-1, 0], MetaData: {facing: 3}}
        2: {Description: Up, VectorToDest: [0, -1], MetaData: {facing: 0}}
        3: {Description: Right, VectorToDest: [1, 0], MetaData: {facing: 1}}
        4: {Description: Down, VectorToDest: [0, 1], MetaData: {facing: 2}}
    Behaviours:
      - Src: {Object: gnome, Commands: [{remove: true}, {reward: -1}]}
        Dst: {Object: spider}
      - Src: {Object: gnome, Commands: [{set_tile: meta.facing}, {mov: _dest}]}
        Dst: {Object: _empty}
      - Src: {Object: gnome, Commands: [{set_tile: meta.facing}, {mov: _dest}]}
        Dst: {Object: [grass, moss, dirt, bones, mushroom, skull, bridge]}
      - Src: {Object: gnome, Commands: [{set_tile: meta.facing}, {reward: 1}]}
        Dst: {Object: gem, Commands: [{remove: true}]}
      - Src: {Object: gnome, Commands: [{set_tile: meta.facing}, {incr: keys}]}
        Dst: {Object: key, Commands: [{remove: true}]}
      - Src:
          Object: gnome
          Preconditions: [{gte: [src.keys, 1]}]
          Commands: [{set_tile: meta.facing}, {decr: keys}]
        Dst: {Object: door, Commands: [{remove: true}]}
      - Src: {Object: gnome, Commands: [{set_tile: meta.facing}]}
        Dst: {Object: [wall, hedge, rock, water, bush, tree, tombstone, torch, nest]}

