      $   .   .   .   .   ,   %   .   ,   ,   ,   ,   %   $   ,   ,   ,   ,   ,   .   .   .   .   .   ,   %   .   $   .   .   .   .   f   .   .   &   f   .   .   .   $
      $   .   .   .   .   .   .   .   ,   ,   .   ,   %   $   .   .   .   .   .   .   .   &   ,   .   .   ,   .   $   ,   ,   .   .   .   .   ,   .   .   .   .   .   $
      $   .   *   .   .   .   .   ~   .   ,   .   &   ,/f $   .   .   ,   .   .   .   f   ,   .   .   .   .   ,   $   ,   ,   ,   .   .   ,   %   .   ,   .   .   .   $
      $   .   .   .   .   ~   ~   .   .   .   .   :   .   ,   %   .   %   ,   .   .   ~   ~   ~   .   .   .   ,   $   ,   ,/c ,   .   ,   *   :/S ,   ,   ,   .   .   $
      $   .   .   .   ~   &   ,   .   .   .   .   :   :   .   .   .   ,   .   .   .   .   .   ~   .   .   .   ,   ,   &   ,   .   .   %   ,   :   :   :   .   .   .   $
