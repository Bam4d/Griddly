Actions:
  - Name: face
    InputMapping:
      Internal: true
      Inputs:
        2: {Description: Face down, VectorToDest: [0, 0], MetaData: {facing: 2}}
    Behaviours:
      - Src: {Object: avatar, Commands: [{set_tile: meta.facing}]}
        Dst: {Object: avatar}

  # The explorer walks up / down / left / right. Traps kill, coins score, the exit wins.
  - Name: move
    InputMapping:
      Inputs:
        1: {Description: Left, VectorToDest: [-1, 0], MetaData: {facing: 3}}
        2: {Description: Up, VectorToDest: [0, -1], MetaData: {facing: 0}}
        3: {Description: Right, VectorToDest: [1, 0], MetaData: {facing: 1}}
        4: {Description: Down, VectorToDest: [0, 1], MetaData: {facing: 2}}
    Behaviours:
      - Src: {Object: avatar, Commands: [{set_tile: meta.facing}, {mov: _dest}]}
        Dst: {Object: [_empty, grass, moss, dirt, sand, bones, mushroom, skull, bridge]}
      - Src: {Object: avatar, Commands: [{set_tile: meta.facing}, {remove: true}, {reward: -1}]}
        Dst: {Object: trap}
      - Src: {Object: avatar, Commands: [{set_tile: meta.facing}, {mov: _dest}, {reward: 1}]}
        Dst: {Object: coin, Commands: [{remove: true}]}
      - Src: {Object: avatar, Commands: [{set_tile: meta.facing}, {reward: 1}]}
        Dst: {Object: exit, Commands: [{remove: true}]}
      - Src: {Object: avatar, Commands: [{set_tile: meta.facing}]}
        Dst: {Object: [wall, water, tree, bush, rock, hedge, stone, tombstone, torch]}

Objects:
  - Name: grass
    MapCharacter: ","
    Z: 0
    Observers:
      Sprite2D: &grass_sprite
        - TilingMode: WALL_16
          Image:
            - gvgai/oryx/grass_0.png
            - gvgai/oryx/grass_1.png
            - gvgai/oryx/grass_2.png
            - gvgai/oryx/grass_3.png
            - gvgai/oryx/grass_4.png
            - gvgai/oryx/grass_5.png
            - gvgai/oryx/grass_6.png
            - gvgai/oryx/grass_7.png
            - gvgai/oryx/grass_8.png
            - gvgai/oryx/grass_9.png
            - gvgai/oryx/grass_10.png
            - gvgai/oryx/grass_11.png
            - gvgai/oryx/grass_12.png
            - gvgai/oryx/grass_13.png
            - gvgai/oryx/grass_14.png
            - gvgai/oryx/grass_15.png
      FollowCam: *grass_sprite
      CloseUp: *grass_sprite
      Block2D:
        - Shape: square
          Color: [0.25, 0.55, 0.25]
          Scale: 0.9
  - Name: moss
    MapCharacter: ";"
    Z: 0
    Observers:
      Sprite2D: &moss_sprite
        - Image: oryx/oryx_tiny_galaxy/tg_sliced/tg_world/tg_world_floor_moss_a.png
      FollowCam: *moss_sprite
      CloseUp: *moss_sprite
      Block2D:
        - Shape: square
          Color: [0.25, 0.4, 0.2]
          Scale: 0.9
  - Name: dirt
    MapCharacter: ":"
    Z: 0
