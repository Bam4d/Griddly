          Commands:
            - remove: true
        Dst:
          Object: hole

  - Name: heal
    Behaviours:
      # Healer can heal adjacent warriors and other healers
      - Src:
          # Can only heal units on your own team
          Preconditions:
            - eq: [src._playerId, dst._playerId]
          Object: healer
        Dst:
          Object: [healer, warrior, king]
          Commands:
