          Object: avatar
          Commands:
            - mov: _dest
        Dst:
          Object: _empty

      # If Avatar hits a trap, remove it
      - Src:
          Object: avatar
          Commands:
            - remove: true
            - reward: -1
        Dst:
          Object: trap

      # If Avatar hits the exit, remove the exit
      - Src:
          Object: avatar
          Commands:
            - reward: 1
        Dst:
          Object: exit
          Commands:
            - remove: true            

