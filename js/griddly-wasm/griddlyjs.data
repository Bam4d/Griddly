      FollowCam: *bones_sprite
      CloseUp: *bones_sprite
      Block2D:
        - Shape: square
          Color: [0.8, 0.8, 0.75]
          Scale: 0.9
  - Name: mushroom
    MapCharacter: "*"
    Z: 0
    Observers:
      Sprite2D: &mushroom_sprite
        - Image: gvgai/oryx/mushroom2.png
      FollowCam: *mushroom_sprite
      CloseUp: *mushroom_sprite
      Block2D:
        - Shape: square
          Color: [0.8, 0.2, 0.2]
          Scale: 0.9
  - Name: skull
    MapCharacter: "^"
