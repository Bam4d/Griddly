            - gvgai/oryx/grass_14.png
            - gvgai/oryx/grass_15.png
      FollowCam: *grass_sprite
      CloseUp: *grass_sprite
      Block2D:
        - Shape: square
          Color: [0.25, 0.55, 0.25]
          Scale: 0.9
