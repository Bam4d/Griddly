            - oryx/oryx_fantasy/wall8-10.png
            - oryx/oryx_fantasy/wall8-11.png
            - oryx/oryx_fantasy/wall8-12.png
            - oryx/oryx_fantasy/wall8-13.png
            - oryx/oryx_fantasy/wall8-14.png
            - oryx/oryx_fantasy/wall8-15.png
      Block2D:
        - Shape: square
          Color: [0.5, 0.5, 0.5]
          Scale: 0.9
