            - oryx/oryx_fantasy/wall2-13.png
            - oryx/oryx_fantasy/wall2-14.png
            - oryx/oryx_fantasy/wall2-15.png
      FollowCam: *stone_sprite
      CloseUp: *stone_sprite
      Block2D:
        - Shape: square
          Color: [0.45, 0.45, 0.45]
          Scale: 1.0
  - Name: tombstone
    MapCharacter: "!"
    Z: 1
    Observers:
