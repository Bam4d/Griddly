    Observers:
      Sprite2D: &catcher_sprite
        - Image: remastered/butterflies-catcher-up.png
        - Image: remastered/butterflies-catcher-right.png
        - Image: remastered/butterflies-catcher-down.png
        - Image: remastered/butterflies-catcher-left.png
      FollowCam: *catcher_sprite
      CloseUp: *catcher_sprite
      Block2D:
        - Shape: triangle
          Color: [1.0, 1.0, 1.0]
          Scale: 0.8
        - Shape: triangle
          Color: [1.0, 1.0, 1.0]
          Scale: 0.8
        - Shape: triangle
          Color: [1.0, 1.0, 1.0]
          Scale: 0.8
        - Shape: triangle
          Color: [1.0, 1.0, 1.0]
          Scale: 0.8
Version: "0.1"
Environment:
  Name: Clusters Remastered
  Description: |
    Cluster the coloured boxes: push each box against the static block of its own colour and it
    becomes part of it. Boxes break on spikes and spikes are deadly to you too. Walls, water,
    hedges, trees, rocks and tombstones block boxes; grass, sand, moss and dirt don't.
    Generated by studio/griddly-demo/tools/remaster â€” edit the generator, not this file.
  # Cameras are observers. The demo picks one by name and the engine renders it.
  #   Sprite2D   whole level (global observer)
  #   FollowCam  15x11 window that follows the avatar
  #   CloseUp    9x9 window that follows the avatar (also the agent's default view)
  Observers:
    Sprite2D:
      TileSize: 24
      BackgroundTile: oryx/oryx_fantasy/floor1-2.png
      RotateAvatarImage: false
      TrackAvatar: false
    FollowCam:
      Type: SPRITE_2D
      TileSize: 24
      BackgroundTile: oryx/oryx_fantasy/floor1-2.png
      RotateAvatarImage: false
      RotateWithAvatar: false
      TrackAvatar: true
      Width: 15
      Height: 11
    CloseUp:
      Type: SPRITE_2D
      TileSize: 24
      BackgroundTile: oryx/oryx_fantasy/floor1-2.png
      RotateAvatarImage: false
      RotateWithAvatar: false
      TrackAvatar: true
      Width: 9
      Height: 9
    Block2D:
      TileSize: 24
  Variables:
    - Name: box_count
      InitialValue: 0
  Player:
    Observer:
      TrackAvatar: true
      RotateWithAvatar: false
      RotateAvatarImage: false
      Width: 9
      Height: 9
    AvatarObject: avatar
  Termination:
    Win:
      - eq: [box_count, 0]
    Lose:
      - gte: [broken_box:count, 1]
      - eq: [avatar:count, 0]
  Levels:
    # Toy Room | Two colours, a few spikes. Push each box against its own colour.
    - |
      w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w
      w   .   :   :   :   :   @   w   w   .   .   .   :   :   .   w   w   .   .   .   .   .   .   w
      w   .   :/R :   :   :   .   w   w   .   .   _   _   _   :   .   .   .   .   .   .   .   .   w
      w   .   :   :   :   :   :   w   w   .   _   _   _   _   _   w   w   .   .   .   .   .   .   w
      w   .   .   .   :   +   :   w   w   .   +   _   _   _   .   w   w   .   .   .   |   .   .   w
      w   w   .   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   .   w   w   w   w
      w   w   .   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   .   w   w   w   w
      w   |   .   .   .   :   |   w   w   .   .   .   .   .   _   w   w   .   .   .   x   .   .   w
      w   .   r   .   :   :   @   w   w   .   .   _   _   _   _/x w   w   _   _   .   .   .   .   w
      w   :/x .   .   .   :/r .   .   .   u   .   u   _   _   _   A   _   _   _/U _   .   .   .   w
      w   .   .   x   .   .   .   w   w   .   .   _   _   _   .   w   w   _   _   _   .   .   .   w
      w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w   w
    # Flower Beds | Three colours of planters in a hedged garden.
    - |
      $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $   $
