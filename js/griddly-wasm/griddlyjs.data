Actions:
  # Stand still for one tick.
  - Name: wait
    InputMapping:
      Inputs:
        1: {Description: Wait, VectorToDest: [0, 0]}
    Behaviours:
      - Src: {Object: avatar, Commands: [{nop: []}]}
        Dst: {Object: avatar}

  # Relative movement: 1 turn left, 2 forward, 3 turn right, 4 back up (facing kept).
  - Name: move
    InputMapping:
      Relative: true
      Inputs:
        1: {Description: Turn left, OrientationVector: [-1, 0], MetaData: {fwd: 0}}
        2: {Description: Forward, OrientationVector: [0, -1], VectorToDest: [0, -1], MetaData: {fwd: 1}}
        3: {Description: Turn right, OrientationVector: [1, 0], MetaData: {fwd: 0}}
        4: {Description: Back up, OrientationVector: [0, -1], VectorToDest: [0, 1], MetaData: {fwd: 0}}
    Behaviours:
      - Src: {Object: avatar, Commands: [{rot: _dir}]}
        Dst: {Object: avatar}
      - Src: {Object: avatar, Commands: [{mov: _dest}, {set: [hidden, 0]}]}
        Dst: {Object: [_empty, grass, moss, dirt, sand, bones, mushroom, skull, bridge, turn_right, turn_left, turn_back]}
      - Src: {Object: avatar, Commands: [{mov: _dest}, {set: [hidden, 1]}]}
        Dst: {Object: tall_grass}
      - Src: {Object: avatar, Commands: [{mov: _dest}, {set: [hidden, 0]}, {decr: need}, {reward: 1}]}
        Dst: {Object: lantern, Commands: [{remove: true}]}
      - Src:
          Object: avatar
          Preconditions: [{eq: [meta.fwd, 1]}, {eq: [need, 0]}]
          Commands: [{set: [escaped, 1]}, {reward: 5}]
        Dst: {Object: gate}
      - Src: {Object: avatar, Commands: [{remove: true}]}
        Dst: {Object: guard}

  # Every lantern adds itself to `need` when the level starts.
  - Name: count_lantern
    InputMapping:
      Internal: true
      Inputs:
        1: {Description: Count, VectorToDest: [0, 0]}
    Behaviours:
      - Src: {Object: lantern, Commands: [{incr: need}]}
        Dst: {Object: lantern}

  # Guard brain, every tick: step forward every 2nd tick, then look up to 3 tiles ahead.
  - Name: patrol
    InputMapping:
      Internal: true
      Inputs:
        1: {Description: Patrol, VectorToDest: [0, 0]}
    Behaviours:
      - Src:
          Object: guard
          Commands:
            - if: {Conditions: {eq: [mv, 1]}, OnTrue: [{set: [mv, 0]}, {exec: {Action: gstep, ActionId: 1}}], OnFalse: [{set: [mv, 1]}]}
            - set: [clear, 1]
            - exec: {Action: look1, ActionId: 1}
            - if: {Conditions: {eq: [clear, 1]}, OnTrue: [{exec: {Action: look2, ActionId: 1}}]}
            - if: {Conditions: {eq: [clear, 1]}, OnTrue: [{exec: {Action: look3, ActionId: 1}}]}
            - exec: {Action: patrol, ActionId: 1, Delay: 1}
        Dst: {Object: guard}

  # One step along the route; corner stones turn the guard, anything in the way turns it around.
  - Name: gstep
    InputMapping:
      Internal: true
      Relative: true
      Inputs:
        1: {Description: Step forward, VectorToDest: [0, -1]}
    Behaviours:
      - Src: {Object: guard, Commands: [{mov: _dest}]}
        Dst: {Object: [_empty, grass, moss, dirt, sand, bones, mushroom, skull, bridge, tall_grass]}
      - Src: {Object: guard, Commands: [{mov: _dest}, {exec: {Action: gturn, ActionId: 3}}]}
        Dst: {Object: turn_right}
      - Src: {Object: guard, Commands: [{mov: _dest}, {exec: {Action: gturn, ActionId: 1}}]}
        Dst: {Object: turn_left}
      - Src: {Object: guard, Commands: [{mov: _dest}, {exec: {Action: gturn, ActionId: 2}}]}
        Dst: {Object: turn_back}
      - Src: {Object: guard, Commands: [{nop: []}]}
        Dst: {Object: avatar, Commands: [{remove: true}]}
      - Src: {Object: guard, Commands: [{exec: {Action: gturn, ActionId: 2}}]}
        Dst: {Object: [wall, gate, lantern, guard, water, tree, bush, hedge, stone, tombstone, torch]}

  - Name: gturn
    InputMapping:
      Internal: true
      Relative: true
      Inputs:
        1: {Description: Turn left, OrientationVector: [-1, 0]}
        2: {Description: Turn around, OrientationVector: [0, 1]}
        3: {Description: Turn right, OrientationVector: [1, 0]}
    Behaviours:
      - Src: {Object: guard, Commands: [{rot: _dir}]}
        Dst: {Object: guard}

  - Name: look1
    InputMapping:
      Internal: true
      Relative: true
      Inputs:
        1: {Description: Look 1 ahead, VectorToDest: [0, -1]}
    Behaviours:
      - Src: {Object: guard, Commands: [{set: [clear, 0]}]}
        Dst: {Object: [wall, gate, guard, water, tree, bush, hedge, stone, tombstone, torch]}
      - Src: {Object: guard, Preconditions: [{eq: [dst.hidden, 0]}], Commands: [{set: [clear, 0]}]}
        Dst: {Object: avatar, Commands: [{remove: true}]}
  - Name: look2
    InputMapping:
      Internal: true
      Relative: true
      Inputs:
        1: {Description: Look 2 ahead, VectorToDest: [0, -2]}
    Behaviours:
      - Src: {Object: guard, Commands: [{set: [clear, 0]}]}
        Dst: {Object: [wall, gate, guard, water, tree, bush, hedge, stone, tombstone, torch]}
      - Src: {Object: guard, Preconditions: [{eq: [dst.hidden, 0]}], Commands: [{set: [clear, 0]}]}
        Dst: {Object: avatar, Commands: [{remove: true}]}
  - Name: look3
    InputMapping:
      Internal: true
      Relative: true
      Inputs:
        1: {Description: Look 3 ahead, VectorToDest: [0, -3]}
    Behaviours:
      - Src: {Object: guard, Commands: [{set: [clear, 0]}]}
        Dst: {Object: [wall, gate, guard, water, tree, bush, hedge, stone, tombstone, torch]}
      - Src: {Object: guard, Preconditions: [{eq: [dst.hidden, 0]}], Commands: [{set: [clear, 0]}]}
        Dst: {Object: avatar, Commands: [{remove: true}]}

Objects:
  - Name: grass
    MapCharacter: ","
    Z: 0
    Observers:
      Sprite2D: &grass_sprite
        - TilingMode: WALL_16
          Image:
            - gvgai/oryx/grass_0.png
            - gvgai/oryx/grass_1.png
            - gvgai/oryx/grass_2.png
            - gvgai/oryx/grass_3.png
            - gvgai/oryx/grass_4.png
            - gvgai/oryx/grass_5.png
            - gvgai/oryx/grass_6.png
            - gvgai/oryx/grass_7.png
            - gvgai/oryx/grass_8.png
            - gvgai/oryx/grass_9.png
            - gvgai/oryx/grass_10.png
            - gvgai/oryx/grass_11.png
            - gvgai/oryx/grass_12.png
            - gvgai/oryx/grass_13.png
            - gvgai/oryx/grass_14.png
            - gvgai/oryx/grass_15.png
      EgoView: *grass_sprite
      EgoClose: *grass_sprite
      FollowCam: *grass_sprite
      Block2D:
        - Shape: square
          Color: [0.25, 0.55, 0.25]
          Scale: 0.9
  - Name: moss
    MapCharacter: ";"
    Z: 0
    Observers:
      Sprite2D: &moss_sprite
        - Image: oryx/oryx_tiny_galaxy/tg_sliced/tg_world/tg_world_floor_moss_a.png
      EgoView: *moss_sprite
      EgoClose: *moss_sprite
      FollowCam: *moss_sprite
      Block2D:
        - Shape: square
          Color: [0.25, 0.4, 0.2]
          Scale: 0.9
  - Name: dirt
    MapCharacter: ":"
    Z: 0
    Observers:
      Sprite2D: &dirt_sprite
        - Image: oryx/oryx_tiny_galaxy/tg_sliced/tg_world/tg_world_floor_dirt_a.png
      EgoView: *dirt_sprite
      EgoClose: *dirt_sprite
      FollowCam: *dirt_sprite
      Block2D:
        - Shape: square
          Color: [0.3, 0.22, 0.15]
          Scale: 0.9
  - Name: sand
    MapCharacter: "_"
    Z: 0
    Observers:
      Sprite2D: &sand_sprite
        - Image: oryx/oryx_tiny_galaxy/tg_sliced/tg_world/tg_world_floor_sand_a.png
      EgoView: *sand_sprite
      EgoClose: *sand_sprite
      FollowCam: *sand_sprite
      Block2D:
        - Shape: square
          Color: [0.7, 0.55, 0.3]
          Scale: 0.9
  - Name: bones
    MapCharacter: "+"
    Z: 0
