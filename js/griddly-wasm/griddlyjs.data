      FollowCam: *sand_sprite
      CloseUp: *sand_sprite
      Block2D:
        - Shape: square
          Color: [0.7, 0.55, 0.3]
          Scale: 0.9
  - Name: bones
    MapCharacter: "+"
    Z: 0
    Observers:
      Sprite2D: &bones_sprite
        - Image: oryx/oryx_tiny_galaxy/tg_sliced/tg_world/tg_world_bones_a.png
      FollowCam: *bones_sprite
      CloseUp: *bones_sprite
      Block2D:
        - Shape: square
          Color: [0.8, 0.8, 0.75]
          Scale: 0.9
  - Name: mushroom
    MapCharacter: "*"
    Z: 0
    Observers:
      Sprite2D: &mushroom_sprite
        - Image: gvgai/oryx/mushroom2.png
      FollowCam: *mushroom_sprite
      CloseUp: *mushroom_sprite
      Block2D:
        - Shape: square
          Color: [0.8, 0.2, 0.2]
          Scale: 0.9
  - Name: skull
    MapCharacter: "^"
    Z: 0
    Observers:
