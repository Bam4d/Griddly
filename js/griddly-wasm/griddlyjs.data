Environment:
  Name: Spiders Garden
  Description: |
    Collect every gem without touching a spider. Spiders wander at random and nests hatch more of
    them. Keys open doors. Water, walls, hedges, rocks, bushes, trees, tombstones, torches and nests
    block the way; grass, moss, dirt and bridges are walkable.
    Generated by studio/griddly-demo/tools/gen_spiders_garden.py â€” edit that, not this file.
  # Cameras are observers. The demo picks one by name and the engine renders it; nothing about
  # framing lives in JS.
  #   Sprite2D    whole level (global observer)
  #   GnomeCam    15x11 window that follows the gnome
  #   GnomeCloseUp 9x9 window that follows the gnome (also the agent's default view)
  Observers:
    Sprite2D:
      TileSize: 24
      BackgroundTile: oryx/oryx_fantasy/floor3-0.png
      RotateAvatarImage: false
      TrackAvatar: false
    GnomeCam:
      Type: SPRITE_2D
      TileSize: 24
      BackgroundTile: oryx/oryx_fantasy/floor3-0.png
      RotateAvatarImage: false
      RotateWithAvatar: false
      TrackAvatar: true
      Width: 15
      Height: 11
    GnomeCloseUp:
      Type: SPRITE_2D
      TileSize: 24
      BackgroundTile: oryx/oryx_fantasy/floor3-0.png
      RotateAvatarImage: false
      RotateWithAvatar: false
      TrackAvatar: true
      Width: 9
      Height: 9
    Block2D:
      TileSize: 24
  Player:
    Observer:
      TrackAvatar: true
      RotateWithAvatar: false
      RotateAvatarImage: false
      Height: 9
      Width: 9
    AvatarObject: gnome
  Termination:
    Win:
      - eq: [gem:count, 0]
    Lose:
      - eq: [gnome:count, 0]
  Levels:
    # Garden Gate | Find the key to open the walled garden.
    - |
      H   H   H   H   H   H   H   H   H   H   H   H   H   H   H   H   H   H   H   H   H   H   H   H   H   H
      H   .   .   .   .   .   .   .   .   ,   ,   ,   ,   ,   ,   ,   ,   .   .   .   .   .   .   .   .   H
      H   .   A   .   .   ,   ,   .   .   ,   ,   ,/G ,   ,   ,   ,   ,   ,   .   .   .   u   .   .   .   H
      H   .   ,   ,/T .   ,   ,   ,   .   ,   ,   ,/T ,   ,   ,   ,   W   W   W   W   W   W   W   W   .   H
      H   .   .   ,/b ,   ,   .   ,   ,   .   ,   ,/b ,   ,/G ,   .   W   .   .   .   .   .   .   W   .   H
